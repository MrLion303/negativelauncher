<Window x:Class="Negative_Client.GameConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consola de Minecraft"
        Width="860"
        Height="520"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0F14"
        Closing="Window_Closing">

	<Window.Resources>

		<Style x:Key="ConsoleWindowButton"
               TargetType="Button">

			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#DCE4EA"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>

		</Style>

	</Window.Resources>


	<Border
        BorderBrush="#313B45"
        BorderThickness="1"
        Background="#0B0F14">

		<Grid>

			<Grid.RowDefinitions>
				<RowDefinition Height="46"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="32"/>
			</Grid.RowDefinitions>


			<Grid
                Grid.Row="0"
                Background="#1D242B"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="84"/>
				</Grid.ColumnDefinitions>


				<StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0">

					<TextBlock
                        x:Name="ConsoleTitleText"
                        Text="Consola de Minecraft"
                        Foreground="White"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

					<Border
                        Background="#25303A"
                        CornerRadius="10"
                        Padding="8,3"
                        Margin="10,0,0,0">

						<TextBlock
                            Text="SOLO LECTURA"
                            Foreground="#88DDEA"
                            FontSize="9"
                            FontWeight="Bold"/>

					</Border>

				</StackPanel>


				<StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

					<Button
                        Style="{StaticResource ConsoleWindowButton}"
                        Click="Minimize_Click">

						<Border
                            Width="11"
                            Height="2"
                            Background="#DCE4EA"/>

					</Button>

					<Button
                        Content="×"
                        FontSize="17"
                        Style="{StaticResource ConsoleWindowButton}"
                        Click="CloseButton_Click"/>

				</StackPanel>

			</Grid>


			<TextBox
                x:Name="ConsoleTextBox"
                Grid.Row="1"
                Margin="10"
                Padding="10"
                Background="#070A0D"
                Foreground="#D7E0E7"
                BorderBrush="#242E37"
                BorderThickness="1"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="False"
                AcceptsReturn="True"
                AcceptsTab="True"
                TextWrapping="NoWrap"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"/>


			<Grid
                Grid.Row="2"
                Background="#10161C">

				<TextBlock
                    x:Name="ConsoleStatusText"
                    Text="Leyendo salida del juego..."
                    Foreground="#7F8C97"
                    FontSize="10"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"/>

				<Button
                    Content="LIMPIAR"
                    Width="70"
                    Height="22"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Background="#252E37"
                    Foreground="#D7E0E7"
                    BorderThickness="0"
                    FontSize="9"
                    Cursor="Hand"
                    Click="Clear_Click"/>

			</Grid>

		</Grid>

	</Border>

</Window>
