<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Negative_Client</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>Negative_Client.App</StartupObject>

    <!-- Icono del ejecutable. IMPORTANTE: mantenerlo en una sola línea. -->
    <ApplicationIcon Condition="Exists('Assets\negativeclient.ico')">Assets\negativeclient.ico</ApplicationIcon>

    <!-- Publicación -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Incluir librerías nativas dentro del ejecutable -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      Incluir también los archivos de contenido dentro del single-file.
      Al ejecutarse serán extraídos automáticamente para que el código
      que utiliza AppContext.BaseDirectory\Assets siga funcionando.
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- No recortar librerías WPF/CmlLib -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- ReadyToRun desactivado -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>


  <!-- Velopack requiere un punto de entrada propio para procesar instalación y actualizaciones -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>


  <!-- No generar PDB en Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>


  <!-- Dependencias -->
  <ItemGroup>
    <PackageReference Include="CmlLib.Core"
                      Version="4.0.6" />

    <PackageReference Include="CmlLib.Core.Auth.Microsoft"
                      Version="3.3.1" />

    <PackageReference Include="CmlLib.Core.Installer.Forge"
                      Version="1.1.1" />

    <PackageReference Include="DiscordRichPresence"
                      Version="1.2.1" />

    <PackageReference Include="Velopack"
                      Version="1.2.161" />
  </ItemGroup>


  <!-- Todos los assets del launcher -->
  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>