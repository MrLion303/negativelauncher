<UserControl x:Class="Negative_Client.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0D11">

    <UserControl.Resources>

        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#29333E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8D99A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6,6,0,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Background="#58D0E3"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="selected">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Body" Property="Background" Value="#171D24"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E9F2F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E9EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    Background="#151D24"
                                    BorderBrush="#4B5966"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckGlyph"
                                      Stroke="#5EE0F3"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 3,9 L 7,13 L 15,4"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#5EE0F3"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="#20262D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#303841"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DCE3E8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="HitArea"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="2">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="18"
                                      Height="18"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Ellipse x:Name="Glow"
                                             Width="24"
                                             Height="24"
                                             Fill="#1F5EE0F3"
                                             Opacity="0"/>
                                    <Ellipse x:Name="Ring"
                                             Width="18"
                                             Height="18"
                                             Fill="#131A21"
                                             Stroke="#4B5966"
                                             StrokeThickness="1.5"/>
                                    <Ellipse x:Name="Dot"
                                             Width="8"
                                             Height="8"
                                             Fill="#5EE0F3"
                                             Opacity="0"/>
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#79E9F8"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#5EE0F3"/>
                                <Setter TargetName="Ring" Property="Fill" Value="#18242C"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderDecreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#5EE0F3"
                                CornerRadius="999"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderIncreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#27313B"
                                CornerRadius="999"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="ThumbGlow"
                                     Width="28"
                                     Height="28"
                                     Fill="#235EE0F3"
                                     Opacity="0.78"/>
                            <Ellipse x:Name="ThumbBody"
                                     Width="18"
                                     Height="18"
                                     Fill="#F4FCFF"
                                     Stroke="#5EE0F3"
                                     StrokeThickness="2"/>
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="#5EE0F3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbGlow" Property="Opacity" Value="1"/>
                                <Setter TargetName="ThumbBody" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbGlow" Property="Opacity" Value="1"/>
                                <Setter TargetName="ThumbBody" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,2">
                            <Border Height="8"
                                    Background="#1B232B"
                                    CornerRadius="999"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsSliderDecreaseButtonStyle}"
                                                  Height="8"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsSliderIncreaseButtonStyle}"
                                                  Height="8"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10151B"
                BorderBrush="#252E37"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ajustes de Negative Client"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Bottom"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button x:Name="NormalSettingsTabButton"
                            Content="CONFIGURACIÓN"
                            Tag="selected"
                            Style="{StaticResource SettingsTabButton}"
                            Click="NormalSettingsTabButton_Click"/>
                    <Button x:Name="AccountsTabButton"
                            Content="CUENTAS"
                            Margin="32,0,0,0"
                            Style="{StaticResource SettingsTabButton}"
                            Click="AccountsTabButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONFIGURACIÓN -->
        <ScrollViewer x:Name="NormalSettingsView"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,30"
                        MaxWidth="820"
                        HorizontalAlignment="Center">

                <TextBlock Text="MINECRAFT"
                           Foreground="#7D8792"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>

                        <TextBlock Text="Memoria RAM"
                                   Foreground="#DCE0E4"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Cantidad máxima de memoria que Minecraft puede usar."
                                   Foreground="#78838E"
                                   FontSize="12"
                                   Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="RamSlider"
                                    Style="{StaticResource SettingsSlider}"
                                    Minimum="1024"
                                    Maximum="16384"
                                    TickFrequency="256"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="RamSlider_ValueChanged"/>

                            <Border Grid.Column="1"
                                    Background="#20262D"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="12,0,0,0">
                                <TextBlock x:Name="RamValueText"
                                           Text="4096 MB"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Separator Margin="0,18" Background="#303841"/>

                        <TextBlock Text="Java"
                                   Foreground="#DCE0E4"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <CheckBox x:Name="AutomaticJavaCheckBox"
                                  Style="{StaticResource SettingsCheckBox}"
                                  Content="Usar Java automático de Minecraft"
                                  Margin="0,9,0,0"
                                  Checked="AutomaticJavaCheckBox_Changed"
                                  Unchecked="AutomaticJavaCheckBox_Changed"/>

                        <TextBlock Text="Si está activado, Negative Client descargará y usará el Java correcto para la versión."
                                   Foreground="#78838E"
                                   FontSize="12"
                                   Margin="0,5,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomJavaPathTextBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     TextChanged="AutoSaveText_Changed"/>
                            <Button Grid.Column="1"
                                    Content="EXAMINAR"
                                    Style="{StaticResource SettingsActionButton}"
                                    Margin="10,0,0,0"
                                    Click="BrowseJavaButton_Click"/>
                        </Grid>

                        <Separator Margin="0,18" Background="#303841"/>

                        <CheckBox x:Name="CloseLauncherOnGameStartCheckBox"
                                  Style="{StaticResource SettingsCheckBox}"
                                  Content="Cerrar Negative Client al abrir Minecraft"
                                  Checked="AutoSaveToggle_Changed"
                                  Unchecked="AutoSaveToggle_Changed"/>

                        <CheckBox x:Name="ShowGameConsoleCheckBox"
                                  Style="{StaticResource SettingsCheckBox}"
                                  Content="Abrir consola de Minecraft al iniciar el juego"
                                  Margin="0,12,0,0"
                                  Checked="AutoSaveToggle_Changed"
                                  Unchecked="AutoSaveToggle_Changed"/>

                        <Separator Margin="0,18" Background="#303841"/>

                        <TextBlock Text="Argumentos de Java personalizados"
                                   Foreground="#DCE0E4"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <CheckBox x:Name="CustomJavaArgumentsEnabledCheckBox"
                                  Style="{StaticResource SettingsCheckBox}"
                                  Content="Activar argumentos personalizados"
                                  Margin="0,10,0,0"
                                  Checked="CustomJavaArgumentsEnabledCheckBox_Changed"
                                  Unchecked="CustomJavaArgumentsEnabledCheckBox_Changed"/>
                        <TextBox x:Name="CustomJavaArgumentsTextBox"
                                 Height="70"
                                 Margin="0,10,0,0"
                                 Padding="8"
                                 Background="#20262D"
                                 Foreground="White"
                                 BorderBrush="#303841"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="AutoSaveText_Changed"/>

                        <Separator Margin="0,18" Background="#303841"/>

                        <TextBlock Text="Ubicación de instalaciones y Minecraft"
                                   Foreground="#DCE0E4"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallationsLocationTextBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     Foreground="#B9C3CC"
                                     IsReadOnly="True"
                                     IsTabStop="False"/>
                            <Button x:Name="BrowseInstallationsLocationButton"
                                    Grid.Column="1"
                                    Content="CAMBIAR"
                                    Style="{StaticResource SettingsActionButton}"
                                    Margin="10,0,0,0"
                                    Click="BrowseInstallationsLocationButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="InstanceStorageText"
                                   Text="Calculando espacio usado..."
                                   Foreground="#9EA7B1"
                                   FontSize="12"
                                   Margin="0,10,0,0"/>

                        <Separator Margin="0,18" Background="#303841"/>

                        <CheckBox x:Name="HolidayThemesCheckBox"
                                  Style="{StaticResource SettingsCheckBox}"
                                  Content="Aspectos de días festivos del launcher"
                                  Checked="HolidayThemesCheckBox_Changed"
                                  Unchecked="HolidayThemesCheckBox_Changed"/>
                        <TextBlock Text="Cambia automáticamente colores y efectos especiales en las fechas configuradas."
                                   Foreground="#78838E"
                                   FontSize="12"
                                   Margin="26,5,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="PreferencesStatusText"
                                   Text="Los cambios se guardan automáticamente."
                                   Foreground="#9EA7B1"
                                   FontSize="12"
                                   Margin="0,18,0,0"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="MANTENIMIENTO"
                           Foreground="#7D8792"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,24,0,8"/>

                <Border Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Archivos no utilizados"
                                   Foreground="#DCE0E4"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Elimina versiones antiguas de Minecraft y runtimes de Java que ya no utiliza ninguna instalación activa."
                                   Foreground="#78838E"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="CleanupUnusedFilesButton"
                                Content="LIMPIAR ARCHIVOS NO UTILIZADOS"
                                Width="225"
                                Style="{StaticResource SettingsActionButton}"
                                Background="#355663"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="CleanupUnusedFilesButton_Click"/>
                        <TextBlock x:Name="CleanupUnusedFilesStatusText"
                                   Foreground="#9EA7B1"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,24,0,0">
                    <TextBlock x:Name="DeveloperModeText"
                               Text="Modo desarrollador"
                               Foreground="#7D8792"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               HorizontalAlignment="Left"
                               MouseLeftButtonUp="DeveloperModeText_MouseLeftButtonUp"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- CUENTAS -->
        <ScrollViewer x:Name="AccountsView"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">
            <StackPanel Margin="28,22,28,30"
                        MaxWidth="820"
                        HorizontalAlignment="Center">

                <TextBlock Text="TIPO DE CUENTA"
                           Foreground="#7D8792"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Border Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>

                        <WrapPanel>
                            <RadioButton x:Name="PremiumAccountModeRadioButton"
                                         Content="Premium / Microsoft"
                                         GroupName="AccountType"
                                         Style="{StaticResource SettingsRadio}"
                                         Checked="PremiumAccountModeRadioButton_Checked"/>

                            <RadioButton x:Name="OfflineAccountModeRadioButton"
                                         Content="No premium"
                                         GroupName="AccountType"
                                         Style="{StaticResource SettingsRadio}"
                                         Checked="OfflineAccountModeRadioButton_Checked"/>
                        </WrapPanel>

                        <TextBlock x:Name="AccountModeDescriptionText"
                                   Text="Elige cómo quieres identificarte al iniciar Minecraft."
                                   Foreground="#78838E"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </Border>


                <!-- PREMIUM -->
                <StackPanel x:Name="PremiumAccountsPanel">

                    <TextBlock Text="MICROSOFT / MINECRAFT JAVA"
                               Foreground="#7D8792"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,24,0,8"/>

                    <Border Background="#151A20"
                            BorderBrush="#292F36"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">

                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Cuentas Microsoft"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Puedes agregar hasta 3 cuentas y elegir cuál usará el botón JUGAR."
                                               Foreground="#8D97A2"
                                               FontSize="12"
                                               Margin="0,6,18,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        x:Name="AccountStateBadge"
                                        Background="#803A3A"
                                        CornerRadius="14"
                                        Padding="10,5"
                                        VerticalAlignment="Top">

                                    <TextBlock x:Name="AccountStateText"
                                               Text="NO CONECTADO"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <ListBox x:Name="AccountsListBox"
                                     Height="210"
                                     Margin="0,18,0,0"
                                     Background="#11161C"
                                     Foreground="White"
                                     BorderBrush="#303841"
                                     BorderThickness="1"
                                     SelectionChanged="AccountsListBox_SelectionChanged">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="5"
                                                    Background="#252C34"
                                                    VerticalAlignment="Center">

                                                <Grid>
                                                    <TextBlock Text="?"
                                                               Foreground="#89939E"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <Image Source="{Binding SkinHeadPath}"
                                                           Width="48"
                                                           Height="48"
                                                           Stretch="Fill"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Usuario"
                                           Foreground="#78838E"
                                           FontSize="12"/>

                                <TextBlock x:Name="MicrosoftUsernameText"
                                           Grid.Column="1"
                                           Text="—"
                                           Foreground="#E6E9EC"
                                           FontSize="12"/>

                                <TextBlock Grid.Row="1"
                                           Text="UUID"
                                           Foreground="#78838E"
                                           FontSize="12"
                                           Margin="0,7,0,0"/>

                                <TextBlock x:Name="MicrosoftUuidText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="—"
                                           Foreground="#E6E9EC"
                                           FontSize="12"
                                           Margin="0,7,0,0"/>
                            </Grid>

                            <TextBlock x:Name="MicrosoftActionStatusText"
                                       Foreground="#9EA7B1"
                                       FontSize="12"
                                       Margin="2,10,0,0"
                                       TextWrapping="Wrap"/>

                            <WrapPanel HorizontalAlignment="Right"
                                       Margin="0,16,0,0">

                                <Button x:Name="AddAccountButton"
                                        Content="AÑADIR CUENTA"
                                        Width="120"
                                        Style="{StaticResource SettingsActionButton}"
                                        Background="#287A8D"
                                        Margin="0,0,8,8"
                                        Click="AddAccountButton_Click"/>

                                <Button x:Name="UseAccountButton"
                                        Content="USAR ESTA CUENTA"
                                        Width="135"
                                        Style="{StaticResource SettingsActionButton}"
                                        Margin="0,0,8,8"
                                        Click="UseAccountButton_Click"/>

                                <Button x:Name="ReauthenticateButton"
                                        Content="VOLVER A INICIAR SESIÓN"
                                        Width="165"
                                        Style="{StaticResource SettingsActionButton}"
                                        Margin="0,0,8,8"
                                        Click="ReauthenticateButton_Click"/>

                                <Button x:Name="SignOutButton"
                                        Content="CERRAR SESIÓN"
                                        Width="120"
                                        Style="{StaticResource SettingsActionButton}"
                                        Background="#49373A"
                                        Margin="0,0,0,8"
                                        Click="SignOutButton_Click"/>
                            </WrapPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- NO PREMIUM / OFFLINE -->
                <StackPanel x:Name="OfflineAccountPanel"
                            Visibility="Collapsed">

                    <TextBlock Text="PERFIL NO PREMIUM"
                               Foreground="#7D8792"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,24,0,8"/>

                    <Border Background="#151A20"
                            BorderBrush="#292F36"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Perfil local de Minecraft"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="El nombre se comprobará con los servicios públicos de Minecraft. Si ya pertenece a un perfil registrado, Negative Client no permitirá usarlo."
                                       Foreground="#8D97A2"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Nombre de Minecraft"
                                       Foreground="#C7D0D8"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,6"/>

                            <TextBox x:Name="OfflineUsernameTextBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="16"
                                     ToolTip="3 a 16 caracteres: letras, números y guion bajo"
                                     TextChanged="OfflineUsernameTextBox_TextChanged"/>

                            <TextBlock x:Name="OfflineNameStatusText"
                                       Text="Usa de 3 a 16 caracteres: letras, números y guion bajo."
                                       Foreground="#78838E"
                                       FontSize="11"
                                       Margin="2,6,0,0"
                                       TextWrapping="Wrap"/>

                            <Separator Margin="0,18" Background="#303841"/>

                            <TextBlock Text="Skin local"
                                       Foreground="#C7D0D8"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="La skin se aplicará solo en tu cliente. Otros jugadores no recibirán esta skin desde tu perfil."
                                       Foreground="#78838E"
                                       FontSize="11"
                                       Margin="0,5,0,10"
                                       TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="96"
                                        Height="96"
                                        Background="#10151B"
                                        BorderBrush="#303841"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left">

                                    <Grid>
                                        <TextBlock x:Name="OfflineSkinFallbackText"
                                                   Text="SIN SKIN"
                                                   Foreground="#69747E"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Image x:Name="OfflineSkinPreviewImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0">

                                    <TextBlock x:Name="OfflineSkinSelectionText"
                                               Text="Sin skin seleccionada"
                                               Foreground="#AAB4BE"
                                               FontSize="12"
                                               Margin="2,2,0,0"/>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="BrowseOfflineSkinButton"
                                                Content="ELEGIR SKIN"
                                                Width="110"
                                                Style="{StaticResource SettingsActionButton}"
                                                Background="#355663"
                                                Margin="0,0,8,0"
                                                Click="BrowseOfflineSkinButton_Click"/>

                                        <Button x:Name="RemoveOfflineSkinButton"
                                                Content="QUITAR SKIN"
                                                Width="105"
                                                Style="{StaticResource SettingsActionButton}"
                                                Background="#49373A"
                                                Click="RemoveOfflineSkinButton_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="Modelo de brazos"
                                               Foreground="#C7D0D8"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,14,0,6"/>

                                    <WrapPanel>
                                        <RadioButton x:Name="OfflineSkinWideRadioButton"
                                                     Content="Normal (Wide)"
                                                     GroupName="OfflineSkinModel"
                                                     Style="{StaticResource SettingsRadio}"
                                                     IsChecked="True"/>

                                        <RadioButton x:Name="OfflineSkinSlimRadioButton"
                                                     Content="Delgada (Slim)"
                                                     GroupName="OfflineSkinModel"
                                                     Style="{StaticResource SettingsRadio}"
                                                     Margin="18,0,0,0"/>
                                    </WrapPanel>

                                    <TextBlock Text="Wide usa brazos normales; Slim usa brazos más delgados. PNG recomendado: 64×64."
                                               Foreground="#69747E"
                                               FontSize="11"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="OfflineActionStatusText"
                                       Text=""
                                       Foreground="#9EA7B1"
                                       FontSize="12"
                                       Margin="2,14,0,0"
                                       TextWrapping="Wrap"/>

                            <Button x:Name="SaveOfflineProfileButton"
                                    Content="GUARDAR PERFIL NO PREMIUM"
                                    Width="215"
                                    Height="40"
                                    Style="{StaticResource SettingsActionButton}"
                                    Background="#287A8D"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0"
                                    Click="SaveOfflineProfileButton_Click"/>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
