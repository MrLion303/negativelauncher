<Window x:Class="Negative_Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="720"
        Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="Background"
                    Value="#29333E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="CloseButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="44"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DDDDDD"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- CONTROLES TEMATIZADOS -->
        <Style
            x:Key="ScrollBarLineButtonStyle"
            TargetType="RepeatButton">

            <Setter Property="Background" Value="#171E25"/>
            <Setter Property="Foreground" Value="#AEB9C2"/>
            <Setter Property="BorderBrush" Value="#2F3A44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border
                            x:Name="ButtonBody"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBody"
                                    Property="Background"
                                    Value="#26313B"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBody"
                                    Property="Background"
                                    Value="#31404C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style
            x:Key="ScrollBarPageButtonStyle"
            TargetType="RepeatButton">

            <Setter Property="Background" Value="#10161C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style
            x:Key="ScrollBarThumbStyle"
            TargetType="Thumb">

            <Setter Property="Background" Value="#465563"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="ThumbBody"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"/>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ThumbBody"
                                    Property="Background"
                                    Value="#5B6C7B"/>
                            </Trigger>

                            <Trigger Property="IsDragging" Value="True">
                                <Setter
                                    TargetName="ThumbBody"
                                    Property="Background"
                                    Value="#58D0E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <ControlTemplate
            x:Key="VerticalThemedScrollBarTemplate"
            TargetType="ScrollBar">

            <Grid Background="#10161C">

                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>

                <RepeatButton
                    Grid.Row="0"
                    Content="▲"
                    Command="ScrollBar.LineUpCommand"
                    Style="{StaticResource ScrollBarLineButtonStyle}"/>

                <Track
                    x:Name="PART_Track"
                    Grid.Row="1"
                    Orientation="Vertical"
                    IsDirectionReversed="True"
                    Minimum="{TemplateBinding Minimum}"
                    Maximum="{TemplateBinding Maximum}"
                    Value="{TemplateBinding Value}"
                    ViewportSize="{TemplateBinding ViewportSize}">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageUpCommand"
                            Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb
                            MinHeight="28"
                            Style="{StaticResource ScrollBarThumbStyle}"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageDownCommand"
                            Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>

                </Track>

                <RepeatButton
                    Grid.Row="2"
                    Content="▼"
                    Command="ScrollBar.LineDownCommand"
                    Style="{StaticResource ScrollBarLineButtonStyle}"/>

            </Grid>
        </ControlTemplate>


        <ControlTemplate
            x:Key="HorizontalThemedScrollBarTemplate"
            TargetType="ScrollBar">

            <Grid Background="#10161C">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>

                <RepeatButton
                    Grid.Column="0"
                    Content="◀"
                    Command="ScrollBar.LineLeftCommand"
                    Style="{StaticResource ScrollBarLineButtonStyle}"/>

                <Track
                    x:Name="PART_Track"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    IsDirectionReversed="False"
                    Minimum="{TemplateBinding Minimum}"
                    Maximum="{TemplateBinding Maximum}"
                    Value="{TemplateBinding Value}"
                    ViewportSize="{TemplateBinding ViewportSize}">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageLeftCommand"
                            Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb
                            MinWidth="28"
                            Style="{StaticResource ScrollBarThumbStyle}"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Command="ScrollBar.PageRightCommand"
                            Style="{StaticResource ScrollBarPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>

                </Track>

                <RepeatButton
                    Grid.Column="2"
                    Content="▶"
                    Command="ScrollBar.LineRightCommand"
                    Style="{StaticResource ScrollBarLineButtonStyle}"/>

            </Grid>
        </ControlTemplate>


        <Style
            x:Key="ThemedScrollBar"
            TargetType="ScrollBar">

            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#10161C"/>
            <Setter Property="Template" Value="{StaticResource VerticalThemedScrollBarTemplate}"/>

            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="13"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalThemedScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Hace que los ScrollViewer/ListBox/TextBox usen el tema sin tener que
             asignar el estilo manualmente a cada ScrollBar interno. -->
        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource ThemedScrollBar}"/>


        <Style
            x:Key="ThemedCheckBox"
            TargetType="CheckBox">

            <Setter Property="Foreground" Value="#E6E9EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    Background="#151D24"
                                    BorderBrush="#4B5966"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckGlyph"
                                      Stroke="#5EE0F3"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 3,9 L 7,13 L 15,4"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#5EE0F3"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style
            x:Key="ThemedSlider"
            TargetType="Slider">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Height="6"
                                                  Background="#5CD7EA"
                                                  BorderThickness="0"
                                                  IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16"
                                           Height="20"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White"
                                                        BorderBrush="#A9B6C0"
                                                        BorderThickness="1"
                                                        CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Height="6"
                                                  Background="#2A313A"
                                                  BorderThickness="0"
                                                  IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="ThemedProgressBar"
            TargetType="ProgressBar">

            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="#222A32"/>
            <Setter Property="Foreground" Value="#58D0E3"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">

                        <Border
                            x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            ClipToBounds="True">

                            <Grid ClipToBounds="True">

                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Border
        Background="#11161C"
        BorderBrush="#343A41"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- BARRA SUPERIOR -->

            <Grid
                Grid.Row="0"
                Background="#20252B"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock
                    Text="Configuración"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0"/>

                <Button
                    Content="×"
                    Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>

            </Grid>


            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="28,24,28,28">


                    <!-- =============================== -->
                    <!-- CUENTAS                         -->
                    <!-- =============================== -->

                    <TextBlock
                        Text="CUENTAS DE MICROSOFT"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>


                    <Border
                        Background="#191F26"
                        BorderBrush="#303841"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock
                                        Text="Microsoft / Minecraft Java"
                                        Foreground="White"
                                        FontSize="18"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Puedes agregar hasta 3 cuentas y elegir cuál usará el botón JUGAR."
                                        Foreground="#8D97A2"
                                        FontSize="12"
                                        Margin="0,6,18,0"
                                        TextWrapping="Wrap"/>

                                </StackPanel>


                                <Border
                                    Grid.Column="1"
                                    x:Name="AccountStateBadge"
                                    Background="#803A3A"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    VerticalAlignment="Top">

                                    <TextBlock
                                        x:Name="AccountStateText"
                                        Text="NO CONECTADO"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"/>

                                </Border>

                            </Grid>


                            <ListBox
                                x:Name="AccountsListBox"
                                Height="180"
                                Margin="0,18,0,0"
                                Background="#11161C"
                                Foreground="White"
                                BorderBrush="#303841"
                                BorderThickness="1"
                                SelectionChanged="AccountsListBox_SelectionChanged">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="6,5">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>


                                            <Border
                                                Width="48"
                                                Height="48"
                                                CornerRadius="5"
                                                Background="#252C34"
                                                VerticalAlignment="Center">

                                                <Grid>

                                                    <TextBlock
                                                        Text="?"
                                                        Foreground="#89939E"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>

                                                    <Image
                                                        Source="{Binding SkinHeadPath}"
                                                        Width="48"
                                                        Height="48"
                                                        Stretch="Fill"
                                                        SnapsToDevicePixels="True"
                                                        UseLayoutRounding="True"
                                                        RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                                </Grid>

                                            </Border>


                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding DisplayName}"
                                                Foreground="White"
                                                FontSize="13"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0"/>

                                        </Grid>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>


                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock
                                    Text="Usuario"
                                    Foreground="#78838E"
                                    FontSize="12"/>

                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="MicrosoftUsernameText"
                                    Text="—"
                                    Foreground="#E6E9EC"
                                    FontSize="12"/>


                                <TextBlock
                                    Grid.Row="1"
                                    Text="UUID"
                                    Foreground="#78838E"
                                    FontSize="12"
                                    Margin="0,7,0,0"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="MicrosoftUuidText"
                                    Text="—"
                                    Foreground="#E6E9EC"
                                    FontSize="12"
                                    Margin="0,7,0,0"/>

                            </Grid>


                            <TextBlock
                                x:Name="MicrosoftActionStatusText"
                                Text=""
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="2,10,0,0"
                                TextWrapping="Wrap"/>


                            <WrapPanel
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">

                                <Button
                                    x:Name="AddAccountButton"
                                    Content="AÑADIR CUENTA"
                                    Width="120"
                                    Style="{StaticResource ActionButton}"
                                    Background="#287A8D"
                                    Margin="0,0,8,8"
                                    Click="AddAccountButton_Click"/>

                                <Button
                                    x:Name="UseAccountButton"
                                    Content="USAR ESTA CUENTA"
                                    Width="135"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"
                                    Click="UseAccountButton_Click"/>

                                <Button
                                    x:Name="ReauthenticateButton"
                                    Content="VOLVER A INICIAR SESIÓN"
                                    Width="165"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"
                                    Click="ReauthenticateButton_Click"/>

                                <Button
                                    x:Name="SignOutButton"
                                    Content="CERRAR SESIÓN"
                                    Width="120"
                                    Style="{StaticResource ActionButton}"
                                    Background="#49373A"
                                    Margin="0,0,0,8"
                                    Click="SignOutButton_Click"/>

                            </WrapPanel>

                        </StackPanel>

                    </Border>


                    <!-- =============================== -->
                    <!-- MINECRAFT                       -->
                    <!-- =============================== -->

                    <TextBlock
                        Text="MINECRAFT"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,24,0,8"/>


                    <Border
                        Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <StackPanel>

                            <TextBlock
                                Text="Memoria RAM"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Cantidad máxima de memoria que Minecraft puede usar."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="0,4,0,8"/>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>


                                <Slider
                                    x:Name="RamSlider"
                                    Style="{StaticResource ThemedSlider}"
                                    Minimum="1024"
                                    Maximum="16384"
                                    Value="4096"
                                    TickFrequency="256"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="RamSlider_ValueChanged"/>


                                <Border
                                    Grid.Column="1"
                                    Background="#20262D"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="12,0,0,0">

                                    <TextBlock
                                        x:Name="RamValueText"
                                        Text="4096 MB"
                                        Foreground="White"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"/>

                                </Border>

                            </Grid>


                            <Separator
                                Margin="0,18,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Java"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <CheckBox
                                x:Name="AutomaticJavaCheckBox"
                                Style="{StaticResource ThemedCheckBox}"
                                Content="Usar Java automático de Minecraft"
                                Foreground="#DCE0E4"
                                Margin="0,9,0,0"
                                Checked="AutomaticJavaCheckBox_Changed"
                                Unchecked="AutomaticJavaCheckBox_Changed"/>


                            <TextBlock
                                Text="Si está activado, el launcher descargará y usará automáticamente el Java correcto para la versión."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="0,5,0,10"
                                TextWrapping="Wrap"/>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>


                                <TextBox
                                    x:Name="CustomJavaPathTextBox"
                                    Height="34"
                                    Padding="8,6"
                                    Background="#20262D"
                                    Foreground="White"
                                    BorderBrush="#303841"/>


                                <Button
                                    Grid.Column="1"
                                    Content="EXAMINAR"
                                    Style="{StaticResource ActionButton}"
                                    Margin="10,0,0,0"
                                    Click="BrowseJavaButton_Click"/>

                            </Grid>


                            <Separator
                                Margin="0,20,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Comportamiento del launcher"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <CheckBox
                                x:Name="CloseLauncherOnGameStartCheckBox"
                                Style="{StaticResource ThemedCheckBox}"
                                Content="Cerrar Negative Client al abrir Minecraft"
                                Foreground="#DCE0E4"
                                Margin="0,10,0,0"/>

                            <TextBlock
                                Text="Desactivado por defecto. Si se activa, el launcher se cerrará después de iniciar Minecraft correctamente."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="22,5,0,0"
                                TextWrapping="Wrap"/>


                            <Separator
                                Margin="0,20,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Argumentos de Java personalizados"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <CheckBox
                                x:Name="CustomJavaArgumentsEnabledCheckBox"
                                Style="{StaticResource ThemedCheckBox}"
                                Content="Activar argumentos personalizados"
                                Foreground="#DCE0E4"
                                Margin="0,10,0,0"
                                Checked="CustomJavaArgumentsEnabledCheckBox_Changed"
                                Unchecked="CustomJavaArgumentsEnabledCheckBox_Changed"/>


                            <TextBox
                                x:Name="CustomJavaArgumentsTextBox"
                                Height="70"
                                Margin="0,10,0,0"
                                Padding="8"
                                Background="#20262D"
                                Foreground="White"
                                BorderBrush="#303841"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                IsEnabled="False"/>

                            <TextBlock
                                Text="Ejemplo: -XX:+UseG1GC -XX:MaxGCPauseMillis=50"
                                Foreground="#78838E"
                                FontSize="11"
                                Margin="0,5,0,0"/>


                            <Separator
                                Margin="0,20,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Gestión de recursos"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <TextBlock
                                Text="Ubicación de instalaciones y Minecraft"
                                Foreground="#C7D0D8"
                                FontSize="12"
                                Margin="0,10,0,6"/>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>


                                <TextBox
                                    x:Name="InstallationsLocationTextBox"
                                    Height="34"
                                    Padding="8,6"
                                    Background="#20262D"
                                    Foreground="#B9C3CC"
                                    BorderBrush="#303841"
                                    IsReadOnly="True"
                                    IsTabStop="False"/>


                                <Button
                                    x:Name="BrowseInstallationsLocationButton"
                                    Grid.Column="1"
                                    Content="CAMBIAR"
                                    Style="{StaticResource ActionButton}"
                                    Margin="10,0,0,0"
                                    Click="BrowseInstallationsLocationButton_Click"/>

                            </Grid>


                            <TextBlock
                                Text="Dentro de esta carpeta Negative Client guarda instances, cache y archivos temporales. Al cambiarla se moverán las instalaciones existentes."
                                Foreground="#78838E"
                                FontSize="11"
                                Margin="0,6,0,0"
                                TextWrapping="Wrap"/>


                            <TextBlock
                                x:Name="InstanceStorageText"
                                Text="Calculando espacio usado..."
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="0,12,0,8"/>

                            <ProgressBar
                                x:Name="InstanceStorageBar"
                                Style="{StaticResource ThemedProgressBar}"
                                Height="9"
                                Minimum="0"
                                Maximum="100"
                                Value="0"/>


                            <Separator
                                Margin="0,20,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Consola del juego"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <CheckBox
                                x:Name="ShowGameConsoleCheckBox"
                                Style="{StaticResource ThemedCheckBox}"
                                Content="Abrir consola de Minecraft al iniciar el juego"
                                Foreground="#DCE0E4"
                                Margin="0,10,0,0"/>


                            <TextBlock
                                Text="Desactivado por defecto. La consola es únicamente de lectura: muestra la salida y errores del juego, pero no permite enviar comandos."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="22,5,0,0"
                                TextWrapping="Wrap"/>


                            <TextBlock
                                x:Name="PreferencesStatusText"
                                Text="Los cambios se guardan automáticamente."
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>


                    <!-- =============================== -->
                    <!-- DESARROLLADOR                   -->
                    <!-- =============================== -->

                    <Border
                        Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,24,0,0">

                        <TextBlock
                            x:Name="DeveloperModeText"
                            Text="Modo desarrollador"
                            Foreground="#7D8792"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            MouseLeftButtonUp="DeveloperModeText_MouseLeftButtonUp"/>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>
