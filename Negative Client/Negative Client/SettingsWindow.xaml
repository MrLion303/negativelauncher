<Window x:Class="Negative_Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="700"
        Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="Background"
                    Value="#29333E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="CloseButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="44"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DDDDDD"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Border
        Background="#11161C"
        BorderBrush="#343A41"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- BARRA SUPERIOR -->

            <Grid
                Grid.Row="0"
                Background="#20252B"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock
                    Text="Configuración"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0"/>

                <Button
                    Content="×"
                    Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>

            </Grid>


            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="28,24,28,28">


                    <!-- =============================== -->
                    <!-- CUENTAS                         -->
                    <!-- =============================== -->

                    <TextBlock
                        Text="CUENTAS DE MICROSOFT"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>


                    <Border
                        Background="#191F26"
                        BorderBrush="#303841"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <StackPanel>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock
                                        Text="Microsoft / Minecraft Java"
                                        Foreground="White"
                                        FontSize="18"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Puedes agregar varias cuentas y elegir cuál usará el botón JUGAR."
                                        Foreground="#8D97A2"
                                        FontSize="12"
                                        Margin="0,6,18,0"
                                        TextWrapping="Wrap"/>

                                </StackPanel>


                                <Border
                                    Grid.Column="1"
                                    x:Name="AccountStateBadge"
                                    Background="#803A3A"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    VerticalAlignment="Top">

                                    <TextBlock
                                        x:Name="AccountStateText"
                                        Text="NO CONECTADO"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"/>

                                </Border>

                            </Grid>


                            <ListBox
                                x:Name="AccountsListBox"
                                Height="120"
                                Margin="0,18,0,0"
                                Background="#11161C"
                                Foreground="White"
                                BorderBrush="#303841"
                                BorderThickness="1"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="AccountsListBox_SelectionChanged"/>


                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock
                                    Text="Usuario"
                                    Foreground="#78838E"
                                    FontSize="12"/>

                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="MicrosoftUsernameText"
                                    Text="—"
                                    Foreground="#E6E9EC"
                                    FontSize="12"/>


                                <TextBlock
                                    Grid.Row="1"
                                    Text="UUID"
                                    Foreground="#78838E"
                                    FontSize="12"
                                    Margin="0,7,0,0"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="MicrosoftUuidText"
                                    Text="—"
                                    Foreground="#E6E9EC"
                                    FontSize="12"
                                    Margin="0,7,0,0"/>

                            </Grid>


                            <TextBlock
                                x:Name="MicrosoftActionStatusText"
                                Text=""
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="2,10,0,0"
                                TextWrapping="Wrap"/>


                            <WrapPanel
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">

                                <Button
                                    x:Name="AddAccountButton"
                                    Content="AÑADIR CUENTA"
                                    Width="120"
                                    Style="{StaticResource ActionButton}"
                                    Background="#287A8D"
                                    Margin="0,0,8,8"
                                    Click="AddAccountButton_Click"/>

                                <Button
                                    x:Name="UseAccountButton"
                                    Content="USAR ESTA CUENTA"
                                    Width="135"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"
                                    Click="UseAccountButton_Click"/>

                                <Button
                                    x:Name="ReauthenticateButton"
                                    Content="VOLVER A INICIAR SESIÓN"
                                    Width="165"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"
                                    Click="ReauthenticateButton_Click"/>

                                <Button
                                    x:Name="SignOutButton"
                                    Content="CERRAR SESIÓN"
                                    Width="120"
                                    Style="{StaticResource ActionButton}"
                                    Background="#49373A"
                                    Margin="0,0,0,8"
                                    Click="SignOutButton_Click"/>

                            </WrapPanel>

                        </StackPanel>

                    </Border>


                    <!-- =============================== -->
                    <!-- MINECRAFT                       -->
                    <!-- =============================== -->

                    <TextBlock
                        Text="MINECRAFT"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,24,0,8"/>


                    <Border
                        Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <StackPanel>


                            <TextBlock
                                Text="Memoria RAM"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Cantidad máxima de memoria que Minecraft puede usar."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="0,4,0,8"/>


                            <ComboBox
                                x:Name="RamComboBox"
                                Height="34"
                                Background="#20262D"
                                Foreground="Black">

                                <ComboBoxItem Content="2 GB"
                                              Tag="2048"/>

                                <ComboBoxItem Content="3 GB"
                                              Tag="3072"/>

                                <ComboBoxItem Content="4 GB"
                                              Tag="4096"/>

                                <ComboBoxItem Content="6 GB"
                                              Tag="6144"/>

                                <ComboBoxItem Content="8 GB"
                                              Tag="8192"/>

                                <ComboBoxItem Content="12 GB"
                                              Tag="12288"/>

                                <ComboBoxItem Content="16 GB"
                                              Tag="16384"/>

                            </ComboBox>


                            <Separator
                                Margin="0,18,0,18"
                                Background="#303841"/>


                            <TextBlock
                                Text="Java"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>


                            <CheckBox
                                x:Name="AutomaticJavaCheckBox"
                                Content="Usar Java automático de Minecraft"
                                Foreground="#DCE0E4"
                                Margin="0,9,0,0"
                                Checked="AutomaticJavaCheckBox_Changed"
                                Unchecked="AutomaticJavaCheckBox_Changed"/>


                            <TextBlock
                                Text="Si está activado, el launcher descargará y usará automáticamente el Java correcto para la versión."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="0,5,0,10"
                                TextWrapping="Wrap"/>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>


                                <TextBox
                                    x:Name="CustomJavaPathTextBox"
                                    Height="34"
                                    Padding="8,6"
                                    Background="#20262D"
                                    Foreground="White"
                                    BorderBrush="#303841"/>


                                <Button
                                    Grid.Column="1"
                                    Content="EXAMINAR"
                                    Style="{StaticResource ActionButton}"
                                    Margin="10,0,0,0"
                                    Click="BrowseJavaButton_Click"/>

                            </Grid>


                            <Button
                                Content="GUARDAR CONFIGURACIÓN"
                                Width="185"
                                Style="{StaticResource ActionButton}"
                                Background="#287A8D"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0"
                                Click="SavePreferencesButton_Click"/>


                            <TextBlock
                                x:Name="PreferencesStatusText"
                                Text=""
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="0,9,0,0"
                                HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>


                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>
