<Window x:Class="Negative_Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración"
        Width="610"
        Height="470"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Background"
                    Value="#29333E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="CloseButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="44"/>

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DDDDDD"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Border
        Background="#11161C"
        BorderBrush="#343A41"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- BARRA SUPERIOR -->

            <Grid
                Grid.Row="0"
                Background="#20252B"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <TextBlock
                    Text="Configuración"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0"/>

                <Button
                    Content="×"
                    Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>

            </Grid>


            <!-- CONTENIDO -->

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="28,24,28,28">


                    <TextBlock
                        Text="CUENTA"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>


                    <Border
                        Background="#191F26"
                        BorderBrush="#303841"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel>

                                    <TextBlock
                                        Text="Microsoft / Minecraft Java"
                                        Foreground="White"
                                        FontSize="18"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Inicia sesión con la cuenta de Microsoft que tenga acceso a Minecraft Java."
                                        Foreground="#8D97A2"
                                        FontSize="12"
                                        Margin="0,6,20,0"
                                        TextWrapping="Wrap"/>

                                </StackPanel>


                                <Border
                                    Grid.Column="1"
                                    x:Name="AccountStateBadge"
                                    Background="#803A3A"
                                    CornerRadius="14"
                                    Padding="10,5"
                                    VerticalAlignment="Top">

                                    <TextBlock
                                        x:Name="AccountStateText"
                                        Text="NO CONECTADO"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="Bold"/>

                                </Border>

                            </Grid>


                            <Border
                                Background="#11161C"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,18,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <TextBlock
                                        Text="Usuario"
                                        Foreground="#78838E"
                                        FontSize="12"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="MicrosoftUsernameText"
                                        Text="—"
                                        Foreground="#E6E9EC"
                                        FontSize="12"/>


                                    <TextBlock
                                        Grid.Row="1"
                                        Text="UUID"
                                        Foreground="#78838E"
                                        FontSize="12"
                                        Margin="0,9,0,0"/>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        x:Name="MicrosoftUuidText"
                                        Text="—"
                                        Foreground="#E6E9EC"
                                        FontSize="12"
                                        Margin="0,9,0,0"/>

                                </Grid>

                            </Border>


                            <TextBlock
                                x:Name="MicrosoftActionStatusText"
                                Text=""
                                Foreground="#9EA7B1"
                                FontSize="12"
                                Margin="2,12,0,0"/>


                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">

                                <Button
                                    x:Name="SignOutButton"
                                    Content="CERRAR SESIÓN"
                                    Width="130"
                                    Style="{StaticResource ActionButton}"
                                    Background="#393F46"
                                    Margin="0,0,10,0"
                                    Click="SignOutButton_Click"/>

                                <Button
                                    x:Name="SignInButton"
                                    Content="INICIAR SESIÓN"
                                    Width="145"
                                    Style="{StaticResource ActionButton}"
                                    Background="#287A8D"
                                    Click="SignInButton_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <TextBlock
                        Text="MINECRAFT"
                        Foreground="#7D8792"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,24,0,8"/>


                    <Border
                        Background="#151A20"
                        BorderBrush="#292F36"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                        <StackPanel>

                            <TextBlock
                                Text="RAM y Java"
                                Foreground="#DCE0E4"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Estas opciones se conectarán en el siguiente paso del desarrollo."
                                Foreground="#78838E"
                                FontSize="12"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>
