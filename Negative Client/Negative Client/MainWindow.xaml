<Window x:Class="Negative_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Negative Client"
        Width="1150"
        Height="710"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#090B0E">

    <Window.Resources>

        <!-- BOTONES SUPERIORES -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BOTONES CIRCULARES -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="#1C2229"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4FC3D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="26">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BOTÓN PLAY -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="#29333E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Border
        BorderBrush="#34383D"
        BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ========================== -->
            <!-- BARRA SUPERIOR             -->
            <!-- ========================== -->

            <Grid
                Grid.Row="0"
                Background="#292B2E"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="126"/>
                </Grid.ColumnDefinitions>


                <!-- Logo temporal -->
                <TextBlock
                    Grid.Column="0"
                    Text="N"
                    Foreground="#6AD8E8"
                    FontWeight="Bold"
                    FontSize="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>


                <TextBlock
                    Grid.Column="1"
                    Text="Negative Client 0.1.0"
                    Foreground="#F0F0F0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>


                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <Button
                        Content="—"
                        Style="{StaticResource WindowButton}"
                        Click="Minimize_Click"/>

                    <Button
                        Content="□"
                        Style="{StaticResource WindowButton}"
                        Click="Maximize_Click"/>

                    <Button
                        Content="×"
                        Style="{StaticResource WindowButton}"
                        Click="Close_Click"/>

                </StackPanel>

            </Grid>


            <!-- ========================== -->
            <!-- CONTENIDO PRINCIPAL        -->
            <!-- ========================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ====================== -->
                <!-- BARRA IZQUIERDA        -->
                <!-- ====================== -->

                <Border
                    Grid.Column="0"
                    Background="#0D1014"
                    BorderBrush="#252A30"
                    BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- CUENTA MICROSOFT TEMPORAL -->

                        <Button
                            x:Name="AccountButton"
                            Grid.Row="0"
                            Content="?"
                            Style="{StaticResource CircleButton}"
                            Margin="15,20,15,0"
                            ToolTip="Cuenta de Microsoft"/>


                        <!-- AQUÍ APARECERÁN LOS MODPACKS -->

                        <StackPanel
                            x:Name="ModpackList"
                            Grid.Row="1"
                            Margin="15,20,15,10"/>


                        <!-- AGREGAR MODPACK -->

                        <Button
    x:Name="AddModpackButton"
    Grid.Row="2"
    Content="+"
    Style="{StaticResource CircleButton}"
    Margin="15,0,15,15"
    ToolTip="Instalar modpack"
    Click="AddModpackButton_Click"/>

                    </Grid>

                </Border>


                <!-- ====================== -->
                <!-- ÁREA DEL MODPACK       -->
                <!-- ====================== -->

                <Grid
                    Grid.Column="1"
                    Background="#0A0D11">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- CENTRO -->

                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,60">

                        <TextBlock
                            Text="NEGATIVE STUDIOS"
                            Foreground="White"
                            FontSize="42"
                            FontWeight="Light"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            x:Name="SelectedModpackText"
                            Text="Ningún modpack seleccionado"
                            Foreground="#777F89"
                            FontSize="14"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- PARTE INFERIOR -->

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,42">

                        <Button
                            x:Name="PlayButton"
                            Content="PLAY"
                            Style="{StaticResource PlayButtonStyle}"
                            IsEnabled="False"/>

                        <TextBlock
                            x:Name="StatusText"
                            Text="Negative Client listo"
                            Foreground="#69717A"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>