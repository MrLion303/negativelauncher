<Window x:Class="Negative_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Negative Client"
        Width="1150"
        Height="710"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#090B0E">

    <Window.Resources>

        <!-- BOTONES SUPERIORES -->
        <Style x:Key="WindowButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="42"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DDDDDD"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- BOTONES CIRCULARES -->
        <Style x:Key="CircleButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="52"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="Background"
                    Value="#1C2229"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4FC3D7"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="26"
                            ClipToBounds="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PlayButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="400"/>

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Background"
                    Value="#29333E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Border
        BorderBrush="#34383D"
        BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ========================== -->
            <!-- BARRA SUPERIOR             -->
            <!-- ========================== -->

            <Grid
                Grid.Row="0"
                Background="#292B2E"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="126"/>
                </Grid.ColumnDefinitions>


                <TextBlock
                    Grid.Column="0"
                    Text="N"
                    Foreground="#6AD8E8"
                    FontWeight="Bold"
                    FontSize="18"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>


                <TextBlock
                    Grid.Column="1"
                    Text="Negative Client 0.1.0"
                    Foreground="#F0F0F0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>


                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <Button
                        Content="—"
                        Style="{StaticResource WindowButton}"
                        Click="Minimize_Click"/>

                    <Button
                        Content="□"
                        Style="{StaticResource WindowButton}"
                        Click="Maximize_Click"/>

                    <Button
                        Content="×"
                        Style="{StaticResource WindowButton}"
                        Click="Close_Click"/>

                </StackPanel>

            </Grid>


            <!-- ========================== -->
            <!-- CONTENIDO PRINCIPAL        -->
            <!-- ========================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ====================== -->
                <!-- BARRA IZQUIERDA        -->
                <!-- ====================== -->

                <Border
                    Grid.Column="0"
                    Background="#0D1014"
                    BorderBrush="#252A30"
                    BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- INICIO -->

                        <Button
                            x:Name="HomeButton"
                            Grid.Row="0"
                            Content="?"
                            Style="{StaticResource CircleButton}"
                            Margin="15,20,15,0"
                            ToolTip="Inicio"
                            Click="HomeButton_Click"/>


                        <!-- SEPARADOR -->

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="#343A41"
                            Margin="13,14,13,14"/>


                        <!-- INSTALACIONES -->

                        <ScrollViewer
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Disabled">

                            <StackPanel
                                x:Name="ModpackList"
                                Margin="15,0,15,10"/>

                        </ScrollViewer>


                        <!-- BOTONES INFERIORES -->

                        <StackPanel
                            Grid.Row="3"
                            Margin="15,0,15,14">

                            <Button
                                x:Name="AddModpackButton"
                                Content="+"
                                Style="{StaticResource CircleButton}"
                                Margin="0,0,0,10"
                                ToolTip="Instalar modpack"
                                Click="AddModpackButton_Click"/>

                            <Button
                                x:Name="AccountSettingsButton"
                                Content="⚙"
                                Style="{StaticResource CircleButton}"
                                ToolTip="Cuenta y configuración"
                                Click="AccountSettingsButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ====================== -->
                <!-- ÁREA PRINCIPAL         -->
                <!-- ====================== -->

                <Grid
                    Grid.Column="1"
                    Background="#0A0D11">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- FONDO DE LA INSTANCIA -->

                    <Image
                        x:Name="InstanceBackgroundImage"
                        Grid.RowSpan="2"
                        Stretch="UniformToFill"
                        Visibility="Collapsed"/>


                    <!-- CAPA OSCURA PARA LEGIBILIDAD -->

                    <Border
                        x:Name="InstanceBackgroundOverlay"
                        Grid.RowSpan="2"
                        Background="#990A0D11"
                        Visibility="Collapsed"/>


                    <!-- CENTRO -->

                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,60">

                        <TextBlock
                            x:Name="MainTitleText"
                            Text="NEGATIVE STUDIOS"
                            Foreground="White"
                            FontSize="42"
                            FontWeight="Light"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            x:Name="SelectedModpackText"
                            Text="Selecciona o instala una instancia"
                            Foreground="#B8BEC6"
                            FontSize="14"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- PARTE INFERIOR -->

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,42">

                        <StackPanel
                            x:Name="DownloadProgressPanel"
                            Width="400"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">

                            <TextBlock
                                x:Name="DownloadProgressText"
                                Text="Descargando..."
                                Foreground="#D3D7DC"
                                FontSize="12"
                                Margin="2,0,0,6"/>

                            <ProgressBar
                                x:Name="DownloadProgressBar"
                                Height="7"
                                Minimum="0"
                                Maximum="100"
                                Value="0"/>

                        </StackPanel>


                        <Button
                            x:Name="PlayButton"
                            Content="JUGAR"
                            Style="{StaticResource PlayButtonStyle}"
                            IsEnabled="False"
                            Click="PlayButton_Click"/>


                        <TextBlock
                            x:Name="StatusText"
                            Text="Negative Client listo"
                            Foreground="#9DA5AE"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
