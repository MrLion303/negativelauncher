<Window x:Class="Negative_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Negative Client"
        Width="1150"
        Height="710"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#090B0E">

    <Window.Resources>

        <!-- BOTONES SUPERIORES -->
        <Style x:Key="WindowButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="42"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DDDDDD"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- BOTONES CIRCULARES -->
        <Style x:Key="CircleButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="52"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="Background"
                    Value="#1C2229"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#4FC3D7"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="26"
                            ClipToBounds="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PlayButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="400"/>

            <Setter Property="Height"
                    Value="58"/>

            <Setter Property="Background"
                    Value="#29333E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <!-- Contorno brillante animado -->
                            <Border
                                x:Name="GlowBorder"
                                CornerRadius="9"
                                BorderBrush="White"
                                BorderThickness="2"
                                Opacity="0">

                                <Border.Effect>
                                    <DropShadowEffect
                                        Color="White"
                                        BlurRadius="13"
                                        ShadowDepth="0"
                                        Opacity="0.85"/>
                                </Border.Effect>

                            </Border>


                            <Border
                                x:Name="ButtonBody"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="2">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.72"
                                            Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>


                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.24"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="ButtonBody"
                                    Property="Opacity"
                                    Value="0.55"/>

                                <Setter
                                    TargetName="GlowBorder"
                                    Property="Opacity"
                                    Value="0"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- BOTONES DEL MENÚ RÁPIDO DE CUENTAS -->
        <Style x:Key="QuickMenuButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="8"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#2B333C"/>
                </Trigger>

            </Style.Triggers>

        </Style>


    </Window.Resources>


    <Border
        BorderBrush="#34383D"
        BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ========================== -->
            <!-- BARRA SUPERIOR             -->
            <!-- ========================== -->

            <Grid
                Grid.Row="0"
                Background="#292B2E"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="126"/>
                </Grid.ColumnDefinitions>


                <Grid
                    Grid.Column="0">

                    <Image
                        x:Name="TopLeftLogoImage"
                        Width="30"
                        Height="30"
                        Stretch="Uniform"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        x:Name="TopLeftLogoFallbackText"
                        Text="N"
                        Foreground="#6AD8E8"
                        FontWeight="Bold"
                        FontSize="18"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                </Grid>


                <TextBlock
                    Grid.Column="1"
                    Text="Negative Client 0.1.0"
                    Foreground="#F0F0F0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>


                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <Button
                        Style="{StaticResource WindowButton}"
                        Click="Minimize_Click">

                        <Viewbox
                            Width="10"
                            Height="10">

                            <Path
                                Stroke="#DDDDDD"
                                StrokeThickness="1.4"
                                StrokeStartLineCap="Square"
                                StrokeEndLineCap="Square"
                                Data="M 1,8 L 9,8"/>

                        </Viewbox>

                    </Button>

                    <Button
                        Content="□"
                        Style="{StaticResource WindowButton}"
                        Click="Maximize_Click"/>

                    <Button
                        Content="×"
                        Style="{StaticResource WindowButton}"
                        Click="Close_Click"/>

                </StackPanel>

            </Grid>


            <!-- ========================== -->
            <!-- CONTENIDO PRINCIPAL        -->
            <!-- ========================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ====================== -->
                <!-- BARRA IZQUIERDA        -->
                <!-- ====================== -->

                <Border
                    Grid.Column="0"
                    Background="#0D1014"
                    BorderBrush="#252A30"
                    BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- INICIO -->

                        <Button
                            x:Name="HomeButton"
                            Grid.Row="0"
                            Style="{StaticResource CircleButton}"
                            Margin="15,20,15,0"
                            ToolTip="Inicio"
                            Click="HomeButton_Click">

                            <Viewbox
                                Width="24"
                                Height="24">

                                <Path
                                    Fill="White"
                                    Data="M 12,2 L 2,10 L 4.5,10 L 4.5,21 L 9.5,21 L 9.5,14 L 14.5,14 L 14.5,21 L 19.5,21 L 19.5,10 L 22,10 Z"/>

                            </Viewbox>

                        </Button>


                        <!-- SEPARADOR -->

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Background="#343A41"
                            Margin="13,14,13,14"/>


                        <!-- INSTALACIONES -->

                        <ScrollViewer
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollBarVisibility="Disabled">

                            <StackPanel
                                x:Name="ModpackList"
                                Margin="15,0,15,10"/>

                        </ScrollViewer>


                        <!-- BOTONES INFERIORES -->

                        <StackPanel
                            Grid.Row="3"
                            Margin="15,0,15,14">

                            <Button
                                x:Name="AddModpackButton"
                                Content="+"
                                Style="{StaticResource CircleButton}"
                                Margin="0,0,0,10"
                                ToolTip="Instalar modpack"
                                Click="AddModpackButton_Click"/>

                            <Button
                                x:Name="AccountSettingsButton"
                                Content="⚙"
                                Style="{StaticResource CircleButton}"
                                ToolTip="Cuenta y configuración"
                                Click="AccountSettingsButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ====================== -->
                <!-- ÁREA PRINCIPAL         -->
                <!-- ====================== -->

                <Grid
                    Grid.Column="1"
                    Background="#0A0D11">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- FONDO DEL MENÚ PRINCIPAL -->

                    <Image
                        x:Name="HomeBackgroundImage"
                        Grid.RowSpan="2"
                        Stretch="UniformToFill"
                        Visibility="Collapsed"/>

                    <Border
                        x:Name="HomeBackgroundOverlay"
                        Grid.RowSpan="2"
                        Background="Transparent"
                        Visibility="Collapsed"/>


                    <!-- FONDO DE LA INSTANCIA -->

                    <Image
                        x:Name="InstanceBackgroundImage"
                        Grid.RowSpan="2"
                        Stretch="UniformToFill"
                        Visibility="Collapsed"/>


                    <!-- CAPA OSCURA PARA LEGIBILIDAD -->

                    <Border
                        x:Name="InstanceBackgroundOverlay"
                        Grid.RowSpan="2"
                        Background="#990A0D11"
                        Visibility="Collapsed"/>



                    <!-- CUENTA RÁPIDA - SOLO EN INSTALACIONES -->

                    <Grid
                        x:Name="AccountQuickRoot"
                        Grid.RowSpan="2"
                        Panel.ZIndex="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,18,20,0"
                        Visibility="Collapsed">

                        <Button
                            x:Name="AccountQuickButton"
                            Click="AccountQuickButton_Click"
                            Background="#D9181E24"
                            BorderBrush="#3A434D"
                            BorderThickness="1"
                            Padding="7,5"
                            Cursor="Hand">

                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Grid
                                    Width="32"
                                    Height="32">

                                    <Border
                                        x:Name="QuickCurrentHeadFallback"
                                        Background="#28313A"
                                        CornerRadius="5">

                                        <TextBlock
                                            Text="?"
                                            Foreground="#AAB3BC"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <Image
                                        x:Name="QuickCurrentHeadImage"
                                        Width="32"
                                        Height="32"
                                        Stretch="Fill"
                                        Visibility="Collapsed"
                                        SnapsToDevicePixels="True"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                </Grid>

                                <TextBlock
                                    x:Name="QuickCurrentAccountNameText"
                                    Text="Sin cuenta"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Margin="9,0,8,0"/>

                                <Path
                                    Fill="#BFC7CF"
                                    Width="9"
                                    Height="6"
                                    Stretch="Fill"
                                    Data="M 0,0 L 9,0 L 4.5,6 Z"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <Popup
                            x:Name="AccountQuickPopup"
                            PlacementTarget="{Binding ElementName=AccountQuickButton}"
                            Placement="Bottom"
                            HorizontalOffset="-105"
                            VerticalOffset="6"
                            AllowsTransparency="True"
                            StaysOpen="False">

                            <Border
                                Width="255"
                                Background="#F2181E24"
                                BorderBrush="#3A434D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7">

                                <StackPanel>

                                    <StackPanel
                                        x:Name="QuickAccountsListPanel"/>

                                    <Border
                                        Height="1"
                                        Background="#343D46"
                                        Margin="4,6,4,6"/>

                                    <Button
                                        x:Name="QuickAddAccountButton"
                                        Content="+  Añadir otra cuenta"
                                        Style="{StaticResource QuickMenuButtonStyle}"
                                        Click="QuickAddAccountButton_Click"/>

                                </StackPanel>

                            </Border>

                        </Popup>

                    </Grid>

                    <!-- AVISO DE MICROSOFT -->

                    <Border
                        x:Name="MicrosoftWarningBorder"
                        Grid.RowSpan="2"
                        Panel.ZIndex="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,72,20,0"
                        Padding="14,9"
                        Background="#D94C3D"
                        CornerRadius="7"
                        Visibility="Collapsed">

                        <TextBlock
                            Text="Aún no has iniciado sesión con Microsoft!"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="SemiBold"/>

                    </Border>


                    <!-- CENTRO -->

                    <StackPanel
                        x:Name="MainCenterPanel"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,60"
                        Visibility="Collapsed">

                        <TextBlock
                            x:Name="MainTitleText"
                            Text="NEGATIVE STUDIOS"
                            Foreground="White"
                            FontSize="42"
                            FontWeight="Light"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            x:Name="SelectedModpackText"
                            Text="Selecciona o instala una instancia"
                            Foreground="#B8BEC6"
                            FontSize="14"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- PARTE INFERIOR -->

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,42">

                        <StackPanel
                            x:Name="DownloadProgressPanel"
                            Width="400"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">

                            <TextBlock
                                x:Name="DownloadProgressText"
                                Text="Descargando..."
                                Foreground="#D3D7DC"
                                FontSize="12"
                                Margin="2,0,0,6"/>

                            <ProgressBar
                                x:Name="DownloadProgressBar"
                                Height="7"
                                Minimum="0"
                                Maximum="100"
                                Value="0"/>

                        </StackPanel>


                        <Button
                            x:Name="PlayButton"
                            Content="JUGAR"
                            Style="{StaticResource PlayButtonStyle}"
                            IsEnabled="False"
                            Click="PlayButton_Click"/>


                        <TextBlock
                            x:Name="StatusText"
                            Text="Negative Client listo"
                            Foreground="#9DA5AE"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                    </StackPanel>


                    <!-- OPCIONES DE LA INSTALACIÓN -->

                    <Button
                        x:Name="InstanceOptionsButton"
                        Grid.RowSpan="2"
                        Panel.ZIndex="35"
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,18"
                        Content="⚙"
                        FontSize="19"
                        Background="#C51A2027"
                        Foreground="White"
                        BorderBrush="#46515C"
                        BorderThickness="1"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        ToolTip="Opciones de la instalación"
                        Click="InstanceOptionsButton_Click"/>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
