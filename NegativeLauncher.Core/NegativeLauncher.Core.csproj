<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);NEGATIVE_LAUNCHER_MULTIPLATFORM</DefineConstants>
    <NegativeLauncherMicrosoftClientId Condition="'$(NegativeLauncherMicrosoftClientId)' == ''">c8a6f4d3-36ba-4af5-9fe6-e983372e866c</NegativeLauncherMicrosoftClientId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NegativeLauncher.MicrosoftOAuthClientId" Value="$(NegativeLauncherMicrosoftClientId)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Negative Client/Negative Client/Services/ModpackInstallerService.cs" Link="Services/ModpackInstallerService.cs" />
    <Compile Include="../Negative Client/Negative Client/Services/ResourcePackSelectionService.cs" Link="Services/ResourcePackSelectionService.cs" />
    <Compile Include="../Negative Client/Negative Client/Services/OfflineSkinService.cs" Link="Services/OfflineSkinService.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>
</Project>
