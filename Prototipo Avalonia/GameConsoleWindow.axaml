<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NegativeLauncher.AvaloniaPrototype.GameConsoleWindow"
        Title="Consola de Minecraft"
        Width="860" Height="520" MinWidth="620" MinHeight="360"
        Background="#0B0F14" Foreground="#DCE4EA"
        WindowStartupLocation="CenterScreen">
  <Border BorderBrush="#313B45" BorderThickness="1" Background="#0B0F14">
    <Grid RowDefinitions="46,*,32">
      <Border Grid.Row="0" Background="#1D242B" BorderBrush="#313B45" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
            <TextBlock Text="Consola de Minecraft" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Background="#25303A" CornerRadius="10" Padding="8,3">
              <TextBlock Text="SOLO LECTURA" Foreground="#88DDEA" FontSize="9" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
            <Button Content="—" Width="42" Height="42" Background="Transparent" Foreground="#DCE4EA" BorderThickness="0" FontSize="17" Click="Minimize_Click"/>
            <Button Content="×" Width="42" Height="42" Background="Transparent" Foreground="#DCE4EA" BorderThickness="0" FontSize="19" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBox x:Name="ConsoleTextBox" Grid.Row="1" Margin="10" Padding="10"
               Background="#070A0D" Foreground="#D7E0E7" BorderBrush="#242E37" BorderThickness="1"
               FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="NoWrap"/>
      <Border Grid.Row="2" Background="#10161C">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ConsoleStatusText" Text="Leyendo salida del juego…" Foreground="#7F8C97" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="LIMPIAR" Width="70" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" Background="#25303A" Foreground="#DCE4EA" BorderThickness="0" FontSize="9" Click="Clear_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
