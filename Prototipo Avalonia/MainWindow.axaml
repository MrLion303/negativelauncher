<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Negative_Client.Models;assembly=NegativeLauncher.Core"
        xmlns:converters="clr-namespace:NegativeLauncher.AvaloniaPrototype.Converters"
        x:Class="NegativeLauncher.AvaloniaPrototype.MainWindow"
        Title="Negative Client"
        Width="1150" Height="710" MinWidth="900" MinHeight="560"
        Background="#090B0E" Foreground="#E6E9EC" FontFamily="gg sans, Inter"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="15,0"/>
      <Setter Property="Background" Value="#29333E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#36424D"/>
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.window-control:pressed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Background" Value="#20262D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#303841"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="#20262D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#303841"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E6E9EC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Name="CheckBorder" Width="18" Height="18" Background="#151D24" BorderBrush="#4B5966" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
              <Path Name="CheckGlyph" Data="M 3,9 L 7,13 L 15,4" Stroke="#5EE0F3" StrokeThickness="2.1" StrokeLineCap="Round" IsVisible="False"/>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#CheckBorder">
      <Setter Property="BorderBrush" Value="#5EE0F3"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#11161C"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#303841"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="#5CD7EA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="#2A313A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Slider /template/ Track">
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#A9B6C0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.login-window-control">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.login-window-control:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.login-window-control:pressed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.operation-button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.play-button">
      <Setter Property="Width" Value="400"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#29333E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Name="PlayGlowBorder" CornerRadius="9" BorderBrush="White" BorderThickness="2" Opacity="0" BoxShadow="0 0 13 0 #D9FFFFFF"/>
            <Border Name="PlayButtonBody" Background="{TemplateBinding Background}" CornerRadius="8" Margin="2">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.play-button:pointerover /template/ Border#PlayGlowBorder">
      <Setter Property="Opacity" Value="0.72"/>
    </Style>
    <Style Selector="Button.play-button:disabled /template/ Border#PlayGlowBorder">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Button.play-button:disabled /template/ Border#PlayButtonBody">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.circle-nav">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="26"/>
      <Setter Property="Background" Value="#1C2229"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.circle-nav:pointerover">
      <Setter Property="Background" Value="#1C2229"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}"/>
    </Style>
    <Style Selector="Button.circle-nav:pressed">
      <Setter Property="Background" Value="#1C2229"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LauncherAccentBrush}"/>
    </Style>
  </Window.Styles>
  <Window.Resources>
    <ResourceDictionary>
      <converters:MinecraftSkinLayerConverter x:Key="MinecraftSkinFaceConverter" Layer="face"/>
      <converters:MinecraftSkinLayerConverter x:Key="MinecraftSkinHatConverter" Layer="hat"/>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="#34383D" BorderThickness="1,0,1,1" PointerPressed="RootContentGrid_PointerPressed">
  <Grid x:Name="RootContentGrid" PointerPressed="RootContentGrid_PointerPressed">

  <Grid RowDefinitions="48,*">
    <Border Grid.Row="0" Background="#292B2E" PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="50,*,126">
        <Grid Grid.Column="0">
          <Border x:Name="BrandLogoFallback" Width="28" Height="28" CornerRadius="0" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0,0,0">
            <TextBlock Text="N" Foreground="#6AD8E8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image x:Name="BrandLogo" Width="38" Height="38" Stretch="Uniform" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0,0,0"/>
        </Grid>
        <TextBlock x:Name="LauncherVersionText" Grid.Column="1" Text="Negative Client" Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Spacing="0">
          <Button Classes="window-control" Click="MinimizeWindow_Click" ToolTip.Tip="Minimizar">
            <Viewbox Width="10" Height="10">
              <Path Stroke="#DDDDDD" StrokeThickness="1.4" StrokeLineCap="Square" Data="M 1,8 L 9,8"/>
            </Viewbox>
          </Button>
          <Button Classes="window-control" Click="ToggleWindowSize_Click" ToolTip.Tip="Maximizar o restaurar">
            <Viewbox Width="12" Height="12">
              <Path Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" Stroke="#DDDDDD" StrokeThickness="1.3" Fill="Transparent"/>
            </Viewbox>
          </Button>
          <Button Classes="window-control" Click="CloseWindow_Click" ToolTip.Tip="Cerrar">
            <Viewbox Width="12" Height="12">
              <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#DDDDDD" StrokeThickness="1.5" StrokeLineCap="Round"/>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    
    <Grid Grid.Row="1" ColumnDefinitions="86,*">
      <Border Grid.Column="0" Background="#0D1014" BorderBrush="#252A30" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="0">
          <Button x:Name="HomeNav" Classes="circle-nav" Margin="0,20,0,0" ToolTip.Tip="Inicio" Click="HomeNav_Click" Background="#1C2229" BorderBrush="Transparent">
            <Path Data="M 12,2 L 2,10 L 4.5,10 L 4.5,21 L 9.5,21 L 9.5,14 L 14.5,14 L 14.5,21 L 19.5,21 L 19.5,10 L 22,10 Z" Fill="White" Width="24" Height="24" Stretch="Uniform" Margin="-1,-1,0,0"/>
          </Button>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="#343A41" Margin="14,14,14,14"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
          <ItemsControl x:Name="SidebarInstancesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:InstalledInstance">
                <Button Classes="circle-nav" Width="52" Height="52" CornerRadius="26" ToolTip.Tip="{Binding Name}" Click="SidebarInstance_Click" Margin="0,0,0,10" HorizontalAlignment="Center" Background="#1C2229" BorderBrush="Transparent" BorderThickness="1" Padding="0">
                  <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Foreground="#E6E9EC"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="DeveloperNav" Classes="circle-nav" Width="52" Height="52" CornerRadius="26" ToolTip.Tip="Minecraft Vanilla — Modo desarrollador" Click="DeveloperNav_Click" Margin="0,0,0,10" HorizontalAlignment="Center" Background="#1C2229" BorderBrush="Transparent" IsVisible="False" Content="DEV" FontSize="11" FontWeight="Bold"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,0,0,14" HorizontalAlignment="Center" Spacing="10">
          <Button x:Name="ModpacksNav" Classes="circle-nav" ToolTip.Tip="Instalar modpack" Click="ModpacksNav_Click">
             <TextBlock Text="+" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="1,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Button>
          <Button x:Name="GalleryNav" Classes="circle-nav" ToolTip.Tip="Galería de capturas" Click="GalleryNav_Click">
            <Path Data="M 4,7 L 8,7 L 10,4 L 16,4 L 18,7 L 22,7 L 22,20 L 4,20 Z M 13,9 A 4,4 0 1 0 13,17 A 4,4 0 1 0 13,9 Z" Fill="White" Width="23" Height="23" Stretch="Uniform" Margin="-5,0,0,2"/>
          </Button>
          <Button x:Name="SettingsNav" Classes="circle-nav" ToolTip.Tip="Cuenta y configuración" Click="SettingsNav_Click">
             <TextBlock Text="⚙" Foreground="White" FontSize="22" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Button>
        </StackPanel>
        <Button x:Name="InstancesNav" IsVisible="False" Click="InstancesNav_Click" Content="Instancias"/>
      </Grid>
    </Border>
      <Grid Grid.Column="1" ClipToBounds="True">
        <Grid Margin="0">
          <Image x:Name="DeveloperBackgroundImage" Stretch="UniformToFill" IsVisible="False" Opacity="0.92" IsHitTestVisible="False"/>
          <Border x:Name="DeveloperBackgroundOverlay" Background="#8A080C11" IsVisible="False" IsHitTestVisible="False"/>
          <Grid x:Name="HomePage" IsVisible="True" Background="#090B0E" ClipToBounds="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image x:Name="HomeBackgroundImage" Grid.RowSpan="2" Stretch="UniformToFill" IsVisible="False"/>
            <Border x:Name="HomeBackgroundOverlay" Grid.RowSpan="2" Background="Transparent" IsVisible="False" IsHitTestVisible="False"/>
            <Border x:Name="HolidayTintOverlay" Grid.RowSpan="2" ZIndex="150" Background="Transparent" Opacity="0.12" IsVisible="False" IsHitTestVisible="False"/>
            <Border x:Name="HolidayTopAccentStrip" Grid.RowSpan="2" ZIndex="151" Height="5" VerticalAlignment="Top" Background="Transparent" IsVisible="False" IsHitTestVisible="False"/>
            <Border x:Name="HolidayBottomAccentStrip" Grid.RowSpan="2" ZIndex="151" Height="5" VerticalAlignment="Bottom" Background="Transparent" IsVisible="False" IsHitTestVisible="False"/>
            <Canvas x:Name="HolidayEffectsCanvas" Grid.RowSpan="2" ZIndex="210" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" IsHitTestVisible="False"/>
            <Button x:Name="DeveloperHolidayThemeButton" Grid.RowSpan="2" ZIndex="220" Content="TEMA DEV: AUTO" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,20" Padding="12,8" Background="#E1181E24" Foreground="White" BorderBrush="#485460" FontSize="11" FontWeight="SemiBold" IsVisible="False" Click="DeveloperHolidayThemeButton_Click" ToolTip.Tip="Solo modo desarrollador: cambia el tema festivo sin depender de la fecha."/>
            <Border x:Name="HomeAccountWarningBorder" ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,20,0" Padding="14,9" Background="#D94C3D" CornerRadius="7" Cursor="Hand" PointerReleased="MicrosoftWarning_PointerReleased" ToolTip.Tip="Abrir configuración de cuentas" IsVisible="False">
              <TextBlock Text="Aún no has iniciado sesión!" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <Grid x:Name="AccountQuickRoot" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" Width="255" ZIndex="40">
              <Button x:Name="QuickAccountButton" Width="160" Height="44" HorizontalAlignment="Right" Click="QuickAccountButton_Click" Background="#D9181E24" BorderBrush="#3A434D" BorderThickness="1" Padding="7,5" ToolTip.Tip="Cambiar cuenta">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                  <Grid Width="32" Height="32">
                    <Border x:Name="QuickCurrentHeadFallback" Background="#28313A" CornerRadius="5">
                      <TextBlock x:Name="QuickCurrentHeadLetter" Text="?" Foreground="#AAB3BC" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="QuickCurrentHeadImage" Width="32" Height="32" Stretch="Fill" IsVisible="False" RenderOptions.BitmapInterpolationMode="None"/>
                    <Image x:Name="QuickCurrentHatImage" Width="32" Height="32" Stretch="Fill" IsVisible="False" RenderOptions.BitmapInterpolationMode="None"/>
                  </Grid>
                  <TextBlock x:Name="QuickCurrentAccountNameText" Width="85" Text="Sin cuenta" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,6,0"/>
                  <Path Data="M 0,0 L 9,0 L 4.5,6 Z" Fill="#BFC7CF" Width="9" Height="6" Stretch="Fill" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Popup x:Name="AccountQuickPopup" PlacementTarget="{Binding #AccountQuickRoot}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="6" IsLightDismissEnabled="True">
                <Border Width="255" Background="#F2181E24" BorderBrush="#3A434D" BorderThickness="1" CornerRadius="8" Padding="7">
                  <StackPanel>
                    <StackPanel x:Name="QuickAccountsListPanel"/>
                    <Border Height="1" Background="#343D46" Margin="4,6,4,6"/>
                    <Button x:Name="QuickAddAccountButton" Content="+  Añadir otra cuenta" Click="QuickAddAccountButton_Click" HorizontalAlignment="Stretch" Padding="8"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
            <TextBlock x:Name="HeaderStatus" Text="Cargando datos…" Foreground="#9DA5AE" FontSize="11" IsVisible="False"/>
            <StackPanel x:Name="MainCenterPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60" Spacing="0" IsVisible="False">
              <TextBlock x:Name="MainTitleText" Text="NEGATIVE STUDIOS" Foreground="White" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/>
              <TextBlock x:Name="HomeSelectedInstanceText" Text="Selecciona o instala una instancia" Foreground="#B8BEC6" FontSize="14" Margin="0,15,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,42" Spacing="0">
              <Border x:Name="DeveloperVersionPanel" Width="610" Margin="0,0,0,12" Padding="12" Background="#D9151B21" BorderBrush="#34404B" BorderThickness="1" CornerRadius="8" IsVisible="False">
                <Grid ColumnDefinitions="Auto,250,Auto,Auto,*" ColumnSpacing="0">
                  <TextBlock Text="Versión de Minecraft" Foreground="#C9D2D9" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox Grid.Column="1" x:Name="DeveloperVersionComboBox" PlaceholderText="Versión de Minecraft" Height="34" SelectionChanged="DeveloperVersionComboBox_SelectionChanged"/>
                  <CheckBox Grid.Column="2" x:Name="DeveloperShowSnapshotsCheckBox" Content="Snapshots" IsChecked="False" IsCheckedChanged="DeveloperVersionFilter_Changed"/>
                  <CheckBox Grid.Column="3" x:Name="DeveloperShowBetasCheckBox" Content="Betas" IsChecked="False" IsCheckedChanged="DeveloperVersionFilter_Changed"/>
                  <Button Grid.Column="4" x:Name="DeveloperReloadVersionsButton" Content="↻" Click="DeveloperReloadVersions_Click" Width="30" Height="30" Padding="0" IsVisible="False"/>
                </Grid>
              </Border>
              <StackPanel x:Name="DeveloperHiddenControls" Spacing="0">
                <Button x:Name="DeveloperPlayButton" Classes="play-button" Content="JUGAR" Click="DeveloperVanillaPlay_Click" IsEnabled="False" Background="#38899A" Foreground="White" Padding="0" Width="400" Height="58" HorizontalAlignment="Center" IsVisible="False" FontSize="12" FontWeight="SemiBold"/>
                <ProgressBar x:Name="DeveloperProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="8"/>
                <TextBlock x:Name="DeveloperStatus" Text="Carga las versiones oficiales de Minecraft." IsVisible="False" Foreground="#B8BEC6" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="CancelDeveloperPreparationButton" Content="Cancelar preparación" Click="CancelDeveloperPreparation_Click" IsVisible="False" HorizontalAlignment="Left" Padding="12,7" Background="#3A2025" Foreground="#FFC4C4"/>
              
              <TextBlock x:Name="ModpackMessage" IsVisible="False" Width="400" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="#F0C674" Margin="0,0,0,8"/>
              <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="7" Width="400" Background="#232C35" Foreground="#55D66B"/>
              
              
              <ProgressBar x:Name="GameProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="7" Width="400" Background="#232C35" Foreground="#55D66B" BorderThickness="0"/>
              <StackPanel x:Name="DownloadProgressPanel" Width="400" Margin="0,0,0,12" IsVisible="False">
                <TextBlock x:Name="RuntimeGlobalOperationMessage" Text="Descargando..." Foreground="#D3D7DC" FontSize="12" Margin="2,0,0,6"/>
                <Border x:Name="DownloadProgressTrack" Height="7" Background="#232C35" CornerRadius="4" ClipToBounds="True">
                  <ProgressBar x:Name="RuntimeGlobalOperationProgress" Minimum="0" Maximum="100" Value="0" Height="7" Background="#232C35" Foreground="#55D66B" BorderThickness="0"/>
                </Border>
              </StackPanel>
              <StackPanel x:Name="RuntimePreparationControls" Orientation="Horizontal" HorizontalAlignment="Center" IsVisible="False" Margin="0,8,0,0">
                <Button Content="Cancelar preparación" Click="CancelRuntimePreparation_Click" Padding="12,6" Background="#3A2025" Foreground="#FFC4C4"/>
              </StackPanel>
              <StackPanel x:Name="ModpackOperationControls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="False" Width="400" Height="50" Margin="0">
                  <Button Classes="operation-button" Content="DETENER" Click="StopModpack_Click" Width="196" Height="46" Background="#743737" Padding="12,6"/>
                  <Button Classes="operation-button" x:Name="PauseResumeModpackButton" Content="PAUSAR" Click="PauseResumeModpack_Click" Width="196" Height="46" Background="#35424E" Padding="12,6"/>
                </StackPanel>
              <Grid x:Name="RuntimeGlobalOperationPanel" HorizontalAlignment="Center" Width="400" Height="50" IsVisible="False" ColumnDefinitions="*,8,*">
                  <Button Classes="operation-button" x:Name="RuntimeGlobalOperationStopButton" Grid.Column="0" Content="DETENER" Click="StopRuntimeOperation_Click" Background="#743737"/>
                  <Button Classes="operation-button" x:Name="RuntimeGlobalOperationPauseResumeButton" Grid.Column="2" Content="PAUSAR" Click="PauseResumeRuntimeOperation_Click" Background="#35424E"/>
              </Grid>

              <Button x:Name="HomePlayButton" Classes="play-button" Content="JUGAR" Click="PlayMainButton_Click" IsEnabled="False" Margin="0,0,0,0"/>
              <TextBlock x:Name="GameStatus" Text="Negative Client listo" Foreground="#9DA5AE" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="620"/>
            </StackPanel>
            <Button x:Name="HomeInstanceOptionsButton" Grid.RowSpan="2" ZIndex="35" Width="46" Height="46" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Content="⚙" FontSize="19" Background="#C51A2027" Foreground="White" BorderBrush="#46515C" BorderThickness="1" IsVisible="False" ToolTip.Tip="Opciones de la instalación" Click="OpenInstanceOptions_Click"/>
            <StackPanel IsVisible="False">
              <TextBlock x:Name="HomeInstanceCount" Text="0"/>
              <TextBlock x:Name="HomeRam" Text="4096 MB"/>
            </StackPanel>
          </Grid>

          <ScrollViewer x:Name="InstancesPage" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Instancias" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Instancias registradas en el almacenamiento configurado." FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="InstancesPathLabel" Text="Carpeta: cargando…" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Actualizar" Click="RefreshInstances_Click" Padding="12,7"/>
                </Grid>
                <TextBlock x:Name="InstancesEmpty" Text="Todavía no hay instancias guardadas. Cuando se instale un modpack, aparecerá aquí." IsVisible="True" TextWrapping="Wrap" Foreground="#B7C0C8" Margin="4,8"/>
                <TextBlock Text="Selecciona una instalación para fijarla en Inicio. Desde Opciones puedes buscar actualizaciones, verificar archivos o eliminarla." Foreground="#8D99A5" FontSize="11" TextWrapping="Wrap" Margin="4,8"/>
                <ItemsControl x:Name="InstancesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledInstance">
                      <Border Classes="instance-card" Tag="{Binding Id}" Background="#0D1218" BorderBrush="#27323D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding MinecraftVersion}" FontSize="12" Foreground="#58D0E3"/>
                              <TextBlock Text="{Binding Loader}" FontSize="11" Foreground="#8D99A5"/>
                              <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#667482"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                              <Border Background="#20352B" CornerRadius="5" Padding="9,5">
                                <TextBlock Text="{Binding IsInstalled, StringFormat='Modpack instalado: {0}'}" Foreground="#A6E3B1" FontSize="10"/>
                              </Border>
                              <TextBlock Text="{Binding RuntimePrepared, StringFormat='Minecraft preparado: {0}'}" FontSize="10" Foreground="#8D99A5"/>
                              <Button Content="Usar en Inicio" Click="SelectInstance_Click" Padding="10,7"/>
                              <Button Content="Preparar / Jugar" Click="PlayInstance_Click" Padding="10,7" Background="#58D0E3" Foreground="#0A0D11"/>
                              <Button Content="Opciones" Click="OpenInstanceOptions_Click" Padding="10,7"/>
                              <Button Content="Eliminar instancia" Click="DeleteInstance_Click" Padding="9,5" Background="#3A2025" Foreground="#FFC4C4"/>
                            </StackPanel>
                          </Grid>
                          <StackPanel Grid.Row="1" Classes="instance-operation-panel" Spacing="7" IsVisible="False">
                            <TextBlock Classes="instance-operation-headline" Foreground="#E6E9EC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Classes="instance-operation-detail" Foreground="#9DA5AE" FontSize="11" TextWrapping="Wrap" MaxHeight="42"/>
                            <ProgressBar Classes="instance-operation-progress" Minimum="0" Maximum="100" Value="0" Height="7" Background="#232C35" Foreground="#55D66B" BorderThickness="0"/>
                            <Grid ColumnDefinitions="*,8,*">
                              <Button Classes="operation-button instance-operation-stop" Grid.Column="0" Content="DETENER" Click="InstanceOperationStop_Click" Background="#743737"/>
                              <Button Classes="operation-button instance-operation-pause" Grid.Column="2" Content="PAUSAR" Click="InstanceOperationPauseResume_Click" Background="#35424E"/>
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InstancesMessage" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>

          <ScrollViewer x:Name="ModpacksPage" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Modpacks" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Instala o actualiza packs usando el catálogo de Negative Studios." FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock Text="Instalar por código" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Configura el ID del archivo JSON del catálogo en Ajustes. El catálogo y los manifiestos deben ser archivos públicos accesibles por Google Drive." TextWrapping="Wrap" Foreground="#B7C0C8"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Código del modpack" FontWeight="SemiBold"/>
                  <TextBox x:Name="InstallCodeInput" Watermark="Código proporcionado por Negative Studios" MaxLength="100"/>
                </StackPanel>
                <Button x:Name="InstallModpackButton" Content="Instalar / actualizar modpack" Click="InstallModpack_Click" Background="#58D0E3" Foreground="#0A0D11" HorizontalAlignment="Left" Padding="16,10"/>
                
                
                
              </StackPanel>
            </Border>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="8">
                <TextBlock Text="Antes de instalar" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="El catálogo y los archivos del modpack se instalan desde aquí. Después, selecciona la instalación en la barra lateral y pulsa JUGAR para preparar Minecraft e iniciarlo con la cuenta activa. La preparación admite Vanilla, Forge, NeoForge, Fabric y Quilt." TextWrapping="Wrap" Foreground="#B7C0C8"/>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>

          <Grid x:Name="GalleryPage" IsVisible="False" Background="#0A0D11" RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" Margin="24,22,24,10" ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Galería de capturas" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Capturas de todas tus instalaciones, ordenadas de la más reciente a la más antigua." Foreground="#87939F" FontSize="12" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="GalleryRefreshButton" Content="ACTUALIZAR" Width="105" Height="36" Background="#252D36" Foreground="White" BorderThickness="0" Click="RefreshGallery_Click"/>
                <Button x:Name="GallerySelectionButton" Content="SELECCIONAR" Width="115" Height="36" Background="#252D36" Foreground="White" BorderThickness="0" Click="ToggleGallerySelection_Click"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0,24,12" Padding="12" Background="#121820" BorderBrush="#28323C" BorderThickness="1" CornerRadius="8">
              <Grid ColumnDefinitions="Auto,230,22,Auto,215,*,Auto" ColumnSpacing="0">
                <TextBlock Grid.Column="0" Text="Instalación" Foreground="#A8B2BC" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GalleryInstanceFilter" Grid.Column="1" Height="34" SelectionChanged="GalleryFilter_Changed"/>
                <TextBlock Grid.Column="3" Text="Orden" Foreground="#A8B2BC" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GallerySortFilter" Grid.Column="4" Height="34" SelectedIndex="0" SelectionChanged="GalleryFilter_Changed">
                  <ComboBoxItem Content="Orden predeterminado" Tag="default"/>
                  <ComboBoxItem Content="Más nuevas → más antiguas" Tag="newest"/>
                  <ComboBoxItem Content="Más antiguas → más nuevas" Tag="oldest"/>
                </ComboBox>
                <TextBlock x:Name="GalleryCountText" Grid.Column="5" Text="0 capturas" Foreground="#7F8B96" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,12,0"/>
                <Button x:Name="GalleryDeleteSelectedButton" Grid.Column="6" Content="ELIMINAR SELECCIONADAS" Height="36" Padding="12,0" Background="#843B3B" Foreground="White" BorderThickness="0" IsVisible="False" Click="DeleteSelectedGallery_Click"/>
              </Grid>
            </Border>
            <Border Grid.Row="2" Margin="24,0,24,24" Background="#0F141A" BorderBrush="#222C35" BorderThickness="1" CornerRadius="9" Padding="0">
              <Grid ClipToBounds="True">
                <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <WrapPanel x:Name="GalleryImagesPanel" Margin="10" Orientation="Horizontal"/>
                </ScrollViewer>
                <TextBlock x:Name="GalleryEmpty" Text="Todavía no hay capturas." IsVisible="True" TextWrapping="Wrap" Foreground="#B7C0C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="GalleryPathLabel" Text="Buscando capturas de instalaciones y archivos…" IsVisible="False"/>
                <TextBlock x:Name="GalleryMessage" IsVisible="False" ZIndex="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18" TextWrapping="Wrap" Foreground="#F0C674" MaxWidth="620"/>
              </Grid>
            </Border>
            <Grid x:Name="GalleryViewerOverlay" Grid.RowSpan="3" ZIndex="100" IsVisible="False" Background="#EB05080C">
              <Grid ColumnDefinitions="80,*,80">
                <Button x:Name="GalleryViewerPreviousButton" Grid.Column="0" Width="50" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#A81A222A" BorderThickness="0" Click="GalleryViewerPrevious_Click">
                  <Path Stroke="White" StrokeThickness="3" StrokeLineCap="Round" Data="M 30,12 L 14,28 L 30,44"/>
                </Button>
                <Grid Grid.Column="1" Margin="10,18">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="GalleryViewerTitle" Text="Captura" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="GalleryViewerDeleteButton" Width="115" Height="38" Margin="0,0,10,0" Background="#843B3B" Foreground="White" BorderThickness="0" Click="GalleryViewerDelete_Click">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                              <Path Fill="White" Data="M 7,5 L 17,5 L 18,8 L 20,8 L 19,19 L 5,19 L 4,8 L 6,8 Z M 9,2 L 15,2 L 16,5 L 8,5 Z M 4,6 L 20,6 L 20,8 L 4,8 Z M 7,20 A 1.5,1.5 0 1 0 10,20 A 1.5,1.5 0 1 0 7,20 Z M 14,20 A 1.5,1.5 0 1 0 17,20 A 1.5,1.5 0 1 0 14,20 Z"/>
                            </Viewbox>
                            <TextBlock Text="Eliminar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button x:Name="GalleryViewerCloseButton" Width="38" Height="38" Content="×" FontSize="20" Background="#252D36" Foreground="White" BorderThickness="0" Click="GalleryViewerClose_Click"/>
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,14,0,14" Background="#05080B" BorderBrush="#29343E" BorderThickness="1" CornerRadius="8">
                      <Image x:Name="GalleryViewerImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <TextBlock x:Name="GalleryViewerDetails" Grid.Row="2" Foreground="#AAB4BE" FontSize="12" TextAlignment="Center"/>
                  </Grid>
                </Grid>
                <Button x:Name="GalleryViewerNextButton" Grid.Column="2" Width="50" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#A81A222A" BorderThickness="0" Click="GalleryViewerNext_Click">
                  <Path Stroke="White" StrokeThickness="3" StrokeLineCap="Round" Data="M 14,12 L 30,28 L 14,44"/>
                </Button>
              </Grid>
            </Grid>
          </Grid>

          <Grid x:Name="SettingsPage" IsVisible="False" Background="Transparent">
            <Border Background="#11161C" BorderBrush="#343A41" BorderThickness="1" CornerRadius="10">
              <Grid RowDefinitions="50,*">
                <Grid Grid.Row="0" Background="#20252B">
                  <TextBlock Text="Configuración" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/>
                  <Button Content="×" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#DDDDDD" BorderThickness="0" FontSize="18" Click="SettingsPageClose_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="28,24,28,28" Spacing="0">
                    <TextBlock Text="CUENTAS DE MICROSOFT" Foreground="#7D8792" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#191F26" BorderBrush="#303841" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel x:Name="AccountsSettingsPanel" IsVisible="True" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Microsoft / Minecraft Java" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Puedes agregar hasta 3 cuentas y elegir cuál usará el botón JUGAR." Foreground="#8D97A2" FontSize="12" Margin="0,6,18,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border x:Name="AccountOverallStateBadge" Grid.Column="1" Background="#803A3A" CornerRadius="14" Padding="10,5" VerticalAlignment="Top">
                    <TextBlock x:Name="AccountOverallStateText" Text="NO CONECTADO" Foreground="White" FontSize="10" FontWeight="Bold"/>
                  </Border>
                </Grid>
                <StackPanel x:Name="PremiumAccountsPanel" Spacing="0">
                  <ListBox x:Name="AccountsList" Height="180" Margin="0,18,0,0" Background="#11161C" Foreground="White" BorderBrush="#303841" BorderThickness="1" SelectionChanged="AccountsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:MicrosoftAccountInfo">
                        <Grid Margin="6,5" ColumnDefinitions="56,*">
                          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="5" Background="#252C34" VerticalAlignment="Center">
                            <Grid>
                              <TextBlock Text="?" Foreground="#89939E" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              <Image Source="{Binding SkinTexturePath, Converter={StaticResource MinecraftSkinFaceConverter}}" Width="48" Height="48" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
                              <Image Source="{Binding SkinTexturePath, Converter={StaticResource MinecraftSkinHatConverter}}" Width="48" Height="48" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
                            </Grid>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid Margin="0,12,0,0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Usuario" Foreground="#78838E" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="MicrosoftUsernameText" Text="—" Foreground="#E6E9EC" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="UUID" Foreground="#78838E" FontSize="12" Margin="0,7,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MicrosoftUuidText" Text="—" Foreground="#E6E9EC" FontSize="12" Margin="0,7,0,0"/>
                  </Grid>
                  <TextBlock x:Name="AccountStatus" Text="Cargando cuentas…" Foreground="#9EA7B1" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"/>
                  <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="AddMicrosoftAccountButton" Content="AÑADIR CUENTA" Width="120" Height="38" Background="#287A8D" Margin="0,0,8,8" Click="AddMicrosoftAccount_Click"/>
                    <Button x:Name="UseSelectedAccountButton" Content="USAR ESTA CUENTA" Width="135" Height="38" Margin="0,0,8,8" Click="UseSelectedAccount_Click"/>
                    <Button x:Name="ReauthenticateAccountButton" Content="VOLVER A INICIAR SESIÓN" Width="165" Height="38" Margin="0,0,8,8" Click="ReauthenticateSelectedAccount_Click"/>
                    <Button x:Name="SignOutAccountButton" Content="CERRAR SESIÓN" Width="120" Height="38" Background="#49373A" Margin="0,0,0,8" Click="SignOutSelectedAccount_Click"/>
                  </WrapPanel>
                </StackPanel>
                
                <StackPanel IsVisible="False" Spacing="0">
                  <Border Background="#151A20" BorderBrush="#292F36" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,6" IsVisible="False">
                <StackPanel Spacing="10">
                  <TextBlock Text="TIPO DE CUENTA" Foreground="#7D8792" FontSize="11" FontWeight="SemiBold"/>
                  <WrapPanel>
                    <RadioButton x:Name="PremiumAccountModeRadioButton" Content="Premium / Microsoft" GroupName="AccountType" Checked="PremiumAccountModeRadioButton_Checked" Margin="0,0,24,0"/>
                    <RadioButton x:Name="OfflineAccountModeRadioButton" Content="No premium" GroupName="AccountType" Checked="OfflineAccountModeRadioButton_Checked"/>
                  </WrapPanel>
                  <TextBlock x:Name="AccountModeDescriptionText" Text="Usa una cuenta Microsoft oficial de Minecraft Java Edition." Foreground="#78838E" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
                  <StackPanel x:Name="OfflineAccountSettingsPanel" IsVisible="False" Spacing="18">
                  <TextBlock Text="Nombre del perfil sin conexión" FontWeight="SemiBold"/>
                  <TextBox x:Name="OfflineUsernameInput" Watermark="Nombre de Minecraft (3–16 caracteres)"/>
                  <TextBlock Text="Modelo de skin" FontWeight="SemiBold"/>
                  <ComboBox x:Name="OfflineSkinModelComboBox" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="210">
                    <ComboBoxItem Content="Clásico (brazos normales)" Tag="wide"/>
                    <ComboBoxItem Content="Delgado (brazos slim)" Tag="slim"/>
                  </ComboBox>
                  <TextBlock Text="Skin PNG del perfil local" FontWeight="SemiBold"/>
                  <Border Background="#10151A" BorderBrush="#303841" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <Border Width="100" Height="100" Background="#20262D" CornerRadius="6" Padding="4">
                        <Image x:Name="OfflineSkinPreviewImage" Stretch="Uniform" IsVisible="False"/>
                      </Border>
                      <TextBlock x:Name="OfflineSkinPreviewFallbackText" Text="Sin vista previa de skin" Width="130" VerticalAlignment="Center" Foreground="#8D99A5" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="OfflineSkinPathLabel" Text="Se usará la skin guardada actualmente." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <Button Content="Elegir skin…" Click="BrowseOfflineSkin_Click" Padding="12,7" Margin="0,0,8,8"/>
                    <Button Content="Quitar skin personalizada" Click="RemoveOfflineSkin_Click" Padding="12,7" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <Button Content="Guardar perfil sin conexión" Click="SaveOfflineProfile_Click" HorizontalAlignment="Left" Padding="12,7"/>
                  <TextBlock Text="Este perfil permite probar el juego sin iniciar sesión en Microsoft. No sirve para entrar a servidores que exijan una cuenta premium." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <TextBlock x:Name="OfflineProfileStatus" IsVisible="False" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
                  <Button x:Name="UseMicrosoftModeButton" Content="USAR CUENTA MICROSOFT" Width="180" Height="38" HorizontalAlignment="Right" IsVisible="False" Click="UseMicrosoftMode_Click" Padding="12,8"/>
                  <Border x:Name="AccountDetailsPanel" IsVisible="False"/>
                  <Border x:Name="SelectedAccountStateBadge" IsVisible="False">
                    <TextBlock x:Name="SelectedAccountStateText" Text="NO CONECTADO"/>
                  </Border>
                </StackPanel>
              </StackPanel></Border>
                    <TextBlock Text="MINECRAFT" Foreground="#7D8792" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8"/>
                    <Border Background="#151A20" BorderBrush="#292F36" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel x:Name="NormalSettingsPanel" IsVisible="True" Spacing="0">
                <StackPanel Spacing="8">
                  <TextBlock Text="Memoria RAM" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="Cantidad máxima de memoria que Minecraft puede usar." Foreground="#78838E" FontSize="12" Margin="0,4,0,8"/>
                  <Grid ColumnDefinitions="*,100">
                    <Slider x:Name="RamSlider" Grid.Column="0" Minimum="1024" Maximum="16384" Value="4096" TickFrequency="256" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RamSlider_ValueChanged" Foreground="#58D0E3" Background="#2A313A"/>
                    <Border Grid.Column="1" Background="#20262D" CornerRadius="6" Padding="10,6" Margin="12,0,0,0">
                      <TextBlock x:Name="RamValueText" Text="4096 MB" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                  </Grid>
                </StackPanel>
                <Separator Margin="0,18,0,18" Background="#303841"/>
                <TextBlock Text="Java" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                <CheckBox x:Name="AutomaticJavaInput" Content="Usar Java automático de Minecraft" Margin="0,9,0,0" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <TextBlock Text="Si está activado, el launcher descargará y usará automáticamente el Java correcto para la versión." Foreground="#78838E" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Ruta de Java personalizada" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="JavaPathInput" Watermark="Ruta de Java personalizada" Height="34" Padding="8,6" Background="#20262D" Foreground="White" BorderBrush="#303841" TextChanged="SettingsAutoSave_Changed"/>
                    <Button Grid.Column="1" Content="EXAMINAR" Width="110" Height="38" Click="BrowseJava_Click" Padding="12,7"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Comprobar Java" Click="CheckJava_Click" Padding="12,7"/>
                    <TextBlock x:Name="JavaStatus" Text="Sin comprobar" VerticalAlignment="Center" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <Separator Margin="0,20,0,18" Background="#303841"/>
                <TextBlock Text="Comportamiento del launcher" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                <CheckBox x:Name="CloseLauncherInput" Content="Cerrar Negative Client al abrir Minecraft" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <TextBlock Text="Desactivado por defecto. Si se activa, el launcher se cerrará después de iniciar Minecraft correctamente." Foreground="#78838E" FontSize="12" Margin="22,5,0,0" TextWrapping="Wrap"/>
                <Separator Margin="0,20,0,18" Background="#303841"/>
                <TextBlock Text="Argumentos de Java personalizados" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                <CheckBox x:Name="EnableCustomJavaArgumentsInput" Content="Activar argumentos personalizados" Margin="0,10,0,0" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Argumentos de Java personalizados" FontWeight="SemiBold"/>
                  <TextBox x:Name="CustomJavaArgumentsInput" IsEnabled="False" Watermark="-XX:+UseG1GC ..." AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" TextChanged="SettingsAutoSave_Changed"/>
                  <TextBlock Text="Se aplican junto con los argumentos que genera el launcher." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                <Separator Margin="0,20,0,18" Background="#303841"/>
                <TextBlock Text="Gestión de recursos" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Ubicación de instalaciones y Minecraft" Foreground="#C7D0D8" FontSize="12" Margin="0,10,0,6"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="StoragePathInput" Height="34" Padding="8,6" Background="#20262D" Foreground="#B9C3CC" BorderBrush="#303841" IsReadOnly="True" IsTabStop="False"/>
                    <Button Grid.Column="1" Content="CAMBIAR" Width="110" Height="38" Margin="10,0,0,0" Click="BrowseStorage_Click" Padding="12,7"/>
                  </Grid>

                </StackPanel>
                <TextBlock Text="Dentro de esta carpeta Negative Client guarda instances, cache y archivos temporales. Al cambiarla se moverán las instalaciones existentes." Foreground="#78838E" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StorageUsageLabel" Text="Calculando…" FontSize="12" Foreground="#9EA7B1" TextWrapping="Wrap"/>
                <ProgressBar x:Name="StorageUsageProgress" Minimum="0" Maximum="100" Value="0" Height="9" Background="#222A32" Foreground="#58D0E3" BorderThickness="0" Margin="0,10,0,10"/>
                <Separator Margin="0,20,0,18" Background="#303841"/>
                <TextBlock Text="Consola del juego" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                <CheckBox x:Name="ShowConsoleInput" Content="Abrir consola de Minecraft al iniciar el juego" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <TextBlock Text="Desactivado por defecto. La consola es únicamente de lectura: muestra la salida y errores del juego, pero no permite enviar comandos." Foreground="#78838E" FontSize="12" Margin="22,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SettingsMessage" Text="Los cambios se guardan automáticamente." HorizontalAlignment="Right" Margin="0,18,0,0" IsVisible="True" TextWrapping="Wrap" Foreground="#9EA7B1" FontSize="12"/>
              </StackPanel></Border>
                    <TextBlock Text="MANTENIMIENTO" Foreground="#7D8792" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8"/>
              <Border Background="#151A20" BorderBrush="#292F36" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                  <TextBlock Text="Archivos no utilizados" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock Text="Elimina versiones antiguas de Minecraft y runtimes de Java que ya no utiliza ninguna versión activa de cada instalación. No toca mods, configuraciones, mundos, capturas ni resource packs." Foreground="#78838E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="La limpieza es conservadora: libraries y assets compartidos se mantienen para evitar romper una instalación." Foreground="#69747E" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  <Button x:Name="CleanupUnusedFilesButton" Content="Limpiar archivos no utilizados" Click="CleanupUnusedFiles_Click" Padding="12,7"/>
                  <TextBlock x:Name="CleanupUnusedFilesStatus" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
                </StackPanel>
              </Border>
                    <Border Background="#151A20" BorderBrush="#292F36" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10,0,0">
                  <TextBlock x:Name="DeveloperModeText" Text="Modo desarrollador" Foreground="#7D8792" FontSize="12" FontWeight="SemiBold" Cursor="Hand" PointerReleased="DeveloperModeText_PointerReleased"/>
                </Border>
                    <Expander x:Name="AdvancedSettingsExpander" Header="OPCIONES AVANZADAS" IsExpanded="False" Foreground="#AEB9C2" Margin="0,12,0,0">
              <Border Background="#151A20" BorderBrush="#292F36" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,10,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Text="Catálogo de modpacks" Foreground="#DCE0E4" FontSize="14" FontWeight="SemiBold"/>
                  <StackPanel Spacing="6">
                  <TextBlock Text="ID del catálogo de modpacks (Google Drive)" FontWeight="SemiBold"/>
                  <TextBox x:Name="CatalogFileIdInput" Watermark="ID del archivo JSON del catálogo" TextChanged="SettingsAutoSave_Changed"/>
                  <TextBlock Text="Se guarda localmente. El archivo debe ser accesible sin iniciar sesión en Google." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                  <CheckBox x:Name="HolidayThemesInput" Content="Aspectos de días festivos del launcher" IsCheckedChanged="SettingsAutoSave_Changed"/>
                  <Separator Background="#303841" Margin="0,4"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Actualizar uso" Click="RefreshStorageUsage_Click" Padding="12,7"/>
                    <Button Content="Limpiar caché de paquetes" Click="ClearPackageCache_Click" Padding="12,7"/>
                    <Button Content="Limpiar temporales" Click="ClearTemporaryFiles_Click" Padding="12,7"/>
                    
                  </StackPanel>
                  <Separator Background="#303841" Margin="0,4"/>
                  <Separator Background="#303841" Margin="0,4"/>
                  <StackPanel Spacing="7">
                  <TextBlock Text="Diagnóstico" FontWeight="SemiBold"/>
                  <TextBlock Text="Los errores se guardan localmente para facilitar las pruebas. El launcher no envía este registro automáticamente." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <Button Content="Abrir carpeta de registros" Click="OpenLogDirectory_Click" HorizontalAlignment="Left" Padding="12,7"/>
                  <TextBlock x:Name="DiagnosticsLogPathLabel" Text="Ruta del registro: cargando…" FontSize="10" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                </StackPanel>
              </Border>
            </Expander>
                    <StackPanel IsVisible="False"><CheckBox x:Name="DeveloperModeInput" Content="Activar modo desarrollador" IsVisible="False" IsCheckedChanged="DeveloperModeInput_Changed"/><StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Guardar ajustes" Click="SaveSettings_Click" Background="#58D0E3" Foreground="#0A0D11" Padding="16,10"/>
                  <Button Content="Restablecer formulario" Click="ReloadSettings_Click" Padding="16,10"/>
                </StackPanel></StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
          <StackPanel x:Name="DeveloperPage" IsVisible="False"/>
          </Grid>
        <StackPanel x:Name="GlobalCountdownHost" ZIndex="10000" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,18,0,0" MaxWidth="1040" IsVisible="False" IsHitTestVisible="False"/>
        <Border x:Name="UpdateAvailableBorder" ZIndex="10001" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,20,0" Padding="14,9" Background="#B8860B" BorderBrush="#E6B84C" BorderThickness="1" CornerRadius="7" IsVisible="False" PointerReleased="UpdateAvailable_Click" ToolTip.Tip="Descargar la versión más reciente">
          <TextBlock x:Name="UpdateAvailableText" Text="Hay una actualización del cliente disponible!" Foreground="#FFF4CC" FontSize="12" FontWeight="SemiBold"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
  <Grid x:Name="LoginGate" Grid.RowSpan="3" ZIndex="100" IsVisible="False" Background="#090B0E" ColumnDefinitions="1.12*,0.88*">
    <Grid Grid.Column="0" ClipToBounds="True">
      <Image x:Name="LoginBackgroundImage" Stretch="UniformToFill" Opacity="0.78"/>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#16090B0E" Offset="0"/>
            <GradientStop Color="#50090B0E" Offset="0.72"/>
            <GradientStop Color="#E6090B0E" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <StackPanel VerticalAlignment="Bottom" Margin="42,40,34,48">
        <Image x:Name="LoginBrandLogo" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <TextBlock Text="NEGATIVE CLIENT" Foreground="White" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Forjamos mundos, creamos experiencias." Foreground="#B9C6D0" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Background="#11151A" RowDefinitions="48,*,42">
      <Grid Grid.Row="0" Background="#292B2E" PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="NEGATIVE CLIENT" Foreground="#D8E0E6" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
            <Button Classes="login-window-control" Click="MinimizeWindow_Click" ToolTip.Tip="Minimizar">
              <Path Data="M 1,8 L 9,8" Stroke="#DDDDDD" StrokeThickness="1.4" StrokeLineCap="Square" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Classes="login-window-control" Click="ToggleWindowSize_Click" ToolTip.Tip="Maximizar o restaurar">
              <Viewbox Width="12" Height="12">
                <Path Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" Stroke="#DDDDDD" StrokeThickness="1.3" Fill="Transparent"/>
              </Viewbox>
            </Button>
            <Button Classes="login-window-control" Click="CloseWindow_Click" ToolTip.Tip="Cerrar">
              <Viewbox Width="12" Height="12">
                <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="#DDDDDD" StrokeThickness="1.5" StrokeLineCap="Round"/>
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,22" VerticalAlignment="Center">
          <TextBlock Text="Bienvenido" Foreground="White" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="Inicia sesión para entrar al launcher." Foreground="#AEB9C2" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,22"/>
          <Border Background="#1A2027" BorderBrush="#343D46" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel Spacing="0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <Grid Width="22" Height="22" Margin="0,0,10,0">
                  <Rectangle Width="10" Height="10" Fill="#F25022" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                  <Rectangle Width="10" Height="10" Fill="#7FBA00" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                  <Rectangle Width="10" Height="10" Fill="#00A4EF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                  <Rectangle Width="10" Height="10" Fill="#FFB900" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="Cuenta Microsoft" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Para Minecraft: Java Edition con una cuenta oficial." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
              <Button x:Name="LoginMicrosoftButton" Click="LoginMicrosoftButton_Click" Height="46" Background="#29333E" Foreground="White" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid Width="16" Height="16" Margin="0,0,10,0">
                    <Rectangle Width="7" Height="7" Fill="#F25022" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Rectangle Width="7" Height="7" Fill="#7FBA00" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Rectangle Width="7" Height="7" Fill="#00A4EF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <Rectangle Width="7" Height="7" Fill="#FFB900" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                  </Grid>
                  <TextBlock Text="Iniciar sesión con Microsoft" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border x:Name="LoginOptionsPanel" IsVisible="True" Background="#171D23" BorderBrush="#343D46" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="0">
              <TextBlock Text="Modo no premium" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Entra con un nombre de usuario, sin autenticar una cuenta Microsoft." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,12"/>
              <Button x:Name="ChooseOfflineLoginButton" Content="Entrar como no premium" Click="ChooseOfflineLoginButton_Click" Height="44" Background="#202A33" Foreground="White"/>
            </StackPanel>
          </Border>
          <Border x:Name="OfflineLoginPanel" IsVisible="False" Background="#171D23" BorderBrush="#343D46" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="0">
              <TextBlock Text="Entrar como no premium" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Elige el nombre que aparecerá en el juego." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,12"/>
              <TextBlock Text="NOMBRE DE USUARIO" Foreground="#AEB9C2" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="OfflineUsernameBox" Watermark="Nombre (3–16 caracteres)" MaxLength="16" Height="40" Padding="10,8"/>
              <Button x:Name="LoginOfflineButton" Content="Entrar" Click="LoginOfflineButton_Click" Height="44" Background="#202A33" Foreground="White" Margin="0,12,0,0"/>
              <Button x:Name="BackToLoginOptionsButton" Content="Volver a las opciones de cuenta" Click="BackToLoginOptionsButton_Click" Height="38" Background="#242B32" Foreground="White" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="LoginStatusText" Foreground="#6AD8E8" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="NegativeStudios" Foreground="#65717B" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
  </Grid>
</Border>
</Window>
