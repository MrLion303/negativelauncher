<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Negative_Client.Models;assembly=NegativeLauncher.Core"
        x:Class="NegativeLauncher.AvaloniaPrototype.MainWindow"
        Title="Negative Client 0.1.1"
        Width="1150" Height="710" MinWidth="900" MinHeight="560"
        Background="#0A0D11" Foreground="#E6E9EC"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None">
  <Window.Styles>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.window-control:pointerover Border.window-control-circle">
      <Setter Property="Background" Value="#45484B"/>
    </Style>
    <Style Selector="Button.window-control:pressed Border.window-control-circle">
      <Setter Property="Background" Value="#2B2D30"/>
    </Style>
  </Window.Styles>
  <Grid x:Name="RootContentGrid">

  <Grid RowDefinitions="48,*">
    <Border Grid.Row="0" Background="#292B2E" BorderBrush="#252A30" BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="50,*,Auto,Auto,140">
        <Grid Grid.Column="0" IsVisible="False">
          <Border x:Name="BrandLogoFallback" Width="28" Height="28" CornerRadius="6" Background="#6AD8E8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="N" Foreground="#0A0D11" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image x:Name="BrandLogo" Width="36" Height="36" Stretch="Uniform" IsVisible="False"/>
        </Grid>
        <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Text="Negative Client 0.1.1" Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock x:Name="HeaderStatus" Grid.Column="2" Text="Cargando datos…" Foreground="#9DA5AE" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="QuickAccountButton" Grid.Column="3" Content="Cuenta ▾" Click="QuickAccountButton_Click" Background="#20262D" Foreground="#E6E9EC" BorderBrush="#3A434D" Padding="12,5" Margin="0,6,8,6"/>
        <Popup x:Name="AccountQuickPopup" PlacementTarget="{Binding #QuickAccountButton}" Placement="Bottom" IsLightDismissEnabled="True">
          <Border Width="255" Background="#F2181E24" BorderBrush="#3A434D" BorderThickness="1" CornerRadius="8" Padding="8">
            <StackPanel Spacing="5">
              <TextBlock Text="CUENTAS MICROSOFT" Foreground="#6AD8E8" FontSize="10" FontWeight="Bold" Margin="5,4"/>
              <StackPanel x:Name="QuickAccountsListPanel" Spacing="3"/>
              <Button x:Name="QuickAddAccountButton" Content="+ Añadir otra cuenta" Click="QuickAddAccountButton_Click" HorizontalAlignment="Stretch" Padding="10,8"/>
              <Button Content="Administrar cuentas en Ajustes" Click="QuickOpenSettings_Click" HorizontalAlignment="Stretch" Padding="10,8"/>
            </StackPanel>
          </Border>
        </Popup>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="0" Margin="0,0,8,0">
          <Button Classes="window-control" Click="MinimizeWindow_Click" ToolTip.Tip="Minimizar">
            <Border Classes="window-control-circle" Width="18" Height="18" CornerRadius="9" Background="#35373A">
              <Path Data="M 5,10 L 13,10" Stroke="#D6D9DB" StrokeThickness="1.35" StrokeLineCap="Round" Width="18" Height="18" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>
          <Button Classes="window-control" Click="ToggleWindowSize_Click" ToolTip.Tip="Maximizar o restaurar">
            <Border Classes="window-control-circle" Width="18" Height="18" CornerRadius="9" Background="#35373A">
              <Path Data="M 5.5,5.5 L 12.5,5.5 L 12.5,12.5 L 5.5,12.5 Z" Stroke="#D6D9DB" StrokeThickness="1.15" StrokeLineCap="Round" Width="18" Height="18" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>
          <Button Classes="window-control" Click="CloseWindow_Click" ToolTip.Tip="Cerrar">
            <Border Classes="window-control-circle" Width="18" Height="18" CornerRadius="9" Background="#35373A">
              <Path Data="M 5.5,5.5 L 12.5,12.5 M 12.5,5.5 L 5.5,12.5" Stroke="#D6D9DB" StrokeThickness="1.35" StrokeLineCap="Round" Width="18" Height="18" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="62,*">
      <Border Grid.Column="0" Background="#0D1014" BorderBrush="#252A30" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Button x:Name="HomeNav" Grid.Row="0" Content="⌂" ToolTip.Tip="Inicio" Click="HomeNav_Click" Width="44" Height="44" Margin="0,16,0,10" HorizontalAlignment="Center" FontSize="24" Background="#26333A" Foreground="#6AD8E8" Padding="0"/>
          <Button x:Name="InstancesNav" Grid.Row="1" Content="▣" ToolTip.Tip="Todas las instalaciones" Click="InstancesNav_Click" Width="44" Height="44" Margin="0,0,0,8" HorizontalAlignment="Center" FontSize="19" Background="Transparent" Padding="0"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SidebarInstancesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledInstance">
                  <Button ToolTip.Tip="{Binding Name}" Click="SidebarInstance_Click" Width="44" Height="44" Margin="0,3" HorizontalAlignment="Center" Background="#20262D" Foreground="#E6E9EC" Padding="2">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="9" MaxLines="3"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,8,0,14" Spacing="8">
            <Button x:Name="ModpacksNav" Content="⇩" ToolTip.Tip="Instalar modpack" Click="ModpacksNav_Click" Width="44" Height="44" HorizontalAlignment="Center" FontSize="22" Background="Transparent" Padding="0"/>
            <Button x:Name="GalleryNav" Content="▧" ToolTip.Tip="Galería de capturas" Click="GalleryNav_Click" Width="44" Height="44" HorizontalAlignment="Center" FontSize="19" Background="Transparent" Padding="0"/>
            <Button x:Name="DeveloperNav" Content="DEV" ToolTip.Tip="Minecraft Vanilla — Modo desarrollador" Click="DeveloperNav_Click" Width="44" Height="34" IsVisible="False" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Background="#20262D" Foreground="#6AD8E8" Padding="0"/>
            <Button x:Name="SettingsNav" Content="⚙" ToolTip.Tip="Configuración" Click="SettingsNav_Click" Width="44" Height="44" HorizontalAlignment="Center" FontSize="20" Background="Transparent" Padding="0"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="1">
        <Grid Margin="0">
          <Grid x:Name="HomePage" IsVisible="True" Background="#0A0D11">
            <Image x:Name="HomeBackgroundImage" Grid.RowSpan="2" Stretch="UniformToFill" IsVisible="False" Opacity="0.92"/>
            <Border x:Name="HomeBackgroundOverlay" Grid.RowSpan="2" Background="#8A080C11" IsHitTestVisible="False"/>
            <Border x:Name="HolidayTintOverlay" Grid.RowSpan="2" Background="Transparent" IsHitTestVisible="False"/>
            <Border x:Name="HolidayTopAccentStrip" Grid.RowSpan="2" Height="5" VerticalAlignment="Top" Background="Transparent" IsVisible="False" IsHitTestVisible="False"/>
            <Border x:Name="HolidayBottomAccentStrip" Grid.RowSpan="2" Height="5" VerticalAlignment="Bottom" Background="Transparent" IsVisible="False" IsHitTestVisible="False"/>
            <Canvas x:Name="HolidayEffectsCanvas" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" IsHitTestVisible="False"/>
            <Button x:Name="DeveloperHolidayThemeButton" Grid.RowSpan="2" Content="TEMA DEV: AUTO" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,20" Padding="12,8" Background="#E1181E24" Foreground="White" BorderBrush="#485460" FontSize="11" FontWeight="SemiBold" IsVisible="False" Click="DeveloperHolidayThemeButton_Click" ToolTip.Tip="Solo modo desarrollador: cambia el tema festivo sin depender de la fecha."/>
            <Border x:Name="HomeAccountWarningBorder" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="18,18,18,0" Background="#D92B2520" BorderBrush="#806B4A" BorderThickness="1" CornerRadius="6" Padding="14,9" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="No hay una cuenta activa para jugar." Foreground="#F0C674" VerticalAlignment="Center" FontSize="12"/>
                <Button Content="Configurar cuenta" Click="OpenAccountsFromWarning_Click" Padding="10,5" Background="#3A3430" Foreground="White"/>
              </StackPanel>
            </Border>
            
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0,30,42" Spacing="0">
              <TextBlock Text="NEGATIVE STUDIOS" Foreground="White" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/>
              <TextBlock x:Name="HomeSelectedInstanceText" Text="Selecciona o instala una instancia" Foreground="#B8BEC6" FontSize="14" Margin="0,15,0,0" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,28,0,0">
                <Button x:Name="HomePlayButton" Content="JUGAR" Click="PlaySelectedInstance_Click" IsEnabled="False" Background="#38899A" Foreground="White" Padding="28,14" FontSize="12" FontWeight="SemiBold"/>
                <Button x:Name="HomeInstanceOptionsButton" Content="OPCIONES" Click="OpenInstanceOptions_Click" IsEnabled="False" Background="#29333E" Foreground="White" Padding="18,12" FontSize="11" FontWeight="SemiBold"/>
                <Button Content="INSTALAR MODPACK" Click="ModpacksNav_Click" Background="#29333E" Foreground="White" Padding="18,12" FontSize="11" FontWeight="SemiBold"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="10">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalAlignment="Center">
                <Border Background="#D9151B21" BorderBrush="#34404B" BorderThickness="1" CornerRadius="6" Padding="14,9">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="INSTANCIAS" Foreground="#87939F" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeInstanceCount" Text="0" Foreground="#6AD8E8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#D9151B21" BorderBrush="#34404B" BorderThickness="1" CornerRadius="6" Padding="14,9">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="RAM MÁXIMA" Foreground="#87939F" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeRam" Text="4096 MB" Foreground="#6AD8E8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
              <ProgressBar x:Name="GameProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="6" Width="420"/>
              <StackPanel x:Name="RuntimePreparationControls" Orientation="Horizontal" HorizontalAlignment="Center" IsVisible="False">
                <Button Content="Cancelar preparación" Click="CancelRuntimePreparation_Click" Padding="12,6" Background="#3A2025" Foreground="#FFC4C4"/>
              </StackPanel>
              <TextBlock x:Name="GameStatus" Text="Negative Client listo" Foreground="#9DA5AE" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="620"/>
            </StackPanel>
          </Grid>

          <StackPanel x:Name="InstancesPage" IsVisible="False" Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Instancias" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Instancias registradas en el almacenamiento configurado." FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="18">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="InstancesPathLabel" Text="Carpeta: cargando…" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Actualizar" Click="RefreshInstances_Click" Padding="12,7"/>
                </Grid>
                <TextBlock x:Name="InstancesEmpty" Text="Todavía no hay instancias guardadas. Cuando se instale un modpack, aparecerá aquí." IsVisible="True" TextWrapping="Wrap" Foreground="#B7C0C8" Margin="4,8"/>
                <TextBlock Text="Selecciona una instalación para fijarla en Inicio. Desde Opciones puedes buscar actualizaciones, verificar archivos o eliminarla." Foreground="#8D99A5" FontSize="11" TextWrapping="Wrap" Margin="4,8"/>
                <ItemsControl x:Name="InstancesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledInstance">
                      <Border Background="#0D1218" BorderBrush="#27323D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MinecraftVersion}" FontSize="12" Foreground="#58D0E3"/>
                            <TextBlock Text="{Binding Loader}" FontSize="11" Foreground="#8D99A5"/>
                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#667482"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#20352B" CornerRadius="5" Padding="9,5">
                              <TextBlock Text="{Binding IsInstalled, StringFormat='Modpack instalado: {0}'}" Foreground="#A6E3B1" FontSize="10"/>
                            </Border>
                            <TextBlock Text="{Binding RuntimePrepared, StringFormat='Minecraft preparado: {0}'}" FontSize="10" Foreground="#8D99A5"/>
                            <Button Content="Usar en Inicio" Click="SelectInstance_Click" Padding="10,7"/>
                            <Button Content="Preparar / Jugar" Click="PlayInstance_Click" Padding="10,7" Background="#58D0E3" Foreground="#0A0D11"/>
                            <Button Content="Opciones" Click="OpenInstanceOptions_Click" Padding="10,7"/>
                            <Button Content="Eliminar instancia" Click="DeleteInstance_Click" Padding="9,5" Background="#3A2025" Foreground="#FFC4C4"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InstancesMessage" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ModpacksPage" IsVisible="False" Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Modpacks" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Instala o actualiza packs usando el catálogo de Negative Studios." FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock Text="Instalar por código" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Configura el ID del archivo JSON del catálogo en Ajustes. El catálogo y los manifiestos deben ser archivos públicos accesibles por Google Drive." TextWrapping="Wrap" Foreground="#B7C0C8"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Código del modpack" FontWeight="SemiBold"/>
                  <TextBox x:Name="InstallCodeInput" Watermark="Código proporcionado por Negative Studios" MaxLength="100"/>
                </StackPanel>
                <Button x:Name="InstallModpackButton" Content="Instalar / actualizar modpack" Click="InstallModpack_Click" Background="#58D0E3" Foreground="#0A0D11" HorizontalAlignment="Left" Padding="16,10"/>
                <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="8"/>
                <StackPanel x:Name="ModpackOperationControls" Orientation="Horizontal" Spacing="8" IsVisible="False">
                  <Button x:Name="PauseResumeModpackButton" Content="Pausar" Click="PauseResumeModpack_Click" Padding="12,7"/>
                  <Button Content="Detener" Click="StopModpack_Click" Padding="12,7" Background="#743737" Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="ModpackMessage" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
              </StackPanel>
            </Border>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="8">
                <TextBlock Text="Antes de instalar" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="El catálogo y los archivos del modpack se instalan desde aquí. Después, selecciona la instalación en la barra lateral y pulsa JUGAR para preparar Minecraft e iniciarlo con la cuenta activa. En esta versión, los loaders admitidos para la preparación son Vanilla y Forge." TextWrapping="Wrap" Foreground="#B7C0C8"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="GalleryPage" IsVisible="False" Spacing="18">
            <TextBlock Text="Galería" FontSize="29" FontWeight="Bold"/>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Capturas de tus partidas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Actualizar galería" Click="RefreshGallery_Click" Padding="12,7"/>
                </Grid>
                <TextBlock x:Name="GalleryPathLabel" Text="Buscando capturas archivadas…" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="Auto,220,Auto,190,*" ColumnSpacing="8" RowDefinitions="Auto">
                  <TextBlock Text="Instalación" VerticalAlignment="Center" Foreground="#B7C0C8"/>
                  <ComboBox x:Name="GalleryInstanceFilter" Grid.Column="1" SelectionChanged="GalleryFilter_Changed" MinWidth="180"/>
                  <TextBlock Grid.Column="2" Text="Ordenar" VerticalAlignment="Center" Foreground="#B7C0C8"/>
                  <ComboBox x:Name="GallerySortFilter" Grid.Column="3" SelectedIndex="0" SelectionChanged="GalleryFilter_Changed">
                    <ComboBoxItem Content="Más recientes" Tag="newest"/>
                    <ComboBoxItem Content="Más antiguas" Tag="oldest"/>
                    <ComboBoxItem Content="Nombre de archivo" Tag="name"/>
                    <ComboBoxItem Content="Instalación" Tag="instance"/>
                  </ComboBox>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="GallerySelectionButton" Content="Seleccionar" Click="ToggleGallerySelection_Click" Padding="12,7"/>
                    <Button x:Name="GalleryDeleteSelectedButton" Content="Eliminar seleccionadas (0)" Click="DeleteSelectedGallery_Click" IsVisible="False" Padding="12,7" Background="#73333A"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="GalleryCountText" Text="0 capturas" FontSize="11" Foreground="#8D99A5"/>
                <TextBlock x:Name="GalleryEmpty" Text="Todavía no hay capturas archivadas. Las capturas de instancias que se hayan archivado aparecerán aquí." IsVisible="True" TextWrapping="Wrap" Foreground="#B7C0C8"/>
                <WrapPanel x:Name="GalleryImagesPanel" Orientation="Horizontal"/>
                <TextBlock x:Name="GalleryMessage" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Ajustes" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Estas preferencias se guardan en el archivo compartido del launcher." FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="NormalSettingsTabButton" Content="GENERAL" Click="ShowNormalSettingsTab_Click" Background="#26333A" Foreground="#6AD8E8" Padding="18,10" FontSize="11" FontWeight="SemiBold"/>
              <Button x:Name="AccountsTabButton" Content="CUENTAS" Click="ShowAccountsSettingsTab_Click" Background="Transparent" Foreground="#8D99A5" Padding="18,10" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="18">
                <StackPanel x:Name="AccountsSettingsPanel" IsVisible="False" Spacing="18">
<StackPanel Spacing="8">
                  <TextBlock Text="CUENTAS" Foreground="#6AD8E8" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="Añade hasta tres cuentas Microsoft y elige cuál usará JUGAR." Foreground="#8D99A5" FontSize="11" TextWrapping="Wrap"/>
                  <ListBox x:Name="AccountsList" Height="108" Background="#0D1218" Foreground="#E6E9EC">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:MicrosoftAccountInfo">
                        <TextBlock Text="{Binding DisplayName}" Margin="6,5" TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="AccountStatus" Text="Cargando cuentas…" Foreground="#8D99A5" FontSize="11" TextWrapping="Wrap"/>
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="AddMicrosoftAccountButton" Content="Añadir cuenta Microsoft" Click="AddMicrosoftAccount_Click" Background="#38899A" Foreground="White" Padding="12,8" Margin="0,0,8,8"/>
                    <Button x:Name="UseSelectedAccountButton" Content="Usar seleccionada" Click="UseSelectedAccount_Click" Padding="12,8" Margin="0,0,8,8"/>
                    <Button x:Name="ReauthenticateAccountButton" Content="Reautenticar" Click="ReauthenticateSelectedAccount_Click" Padding="12,8" Margin="0,0,8,8"/>
                    <Button x:Name="SignOutAccountButton" Content="Cerrar sesión" Click="SignOutSelectedAccount_Click" Padding="12,8" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <Button x:Name="UseMicrosoftModeButton" Content="Usar cuenta Microsoft" Click="UseMicrosoftMode_Click" HorizontalAlignment="Left" Padding="12,8"/>
                </StackPanel>
<StackPanel Spacing="6">
                  <TextBlock Text="Nombre del perfil sin conexión" FontWeight="SemiBold"/>
                  <TextBox x:Name="OfflineUsernameInput" Watermark="Nombre de Minecraft (3–16 caracteres)"/>
                  <TextBlock Text="Modelo de skin" FontWeight="SemiBold"/>
                  <ComboBox x:Name="OfflineSkinModelComboBox" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="210">
                    <ComboBoxItem Content="Clásico (brazos normales)" Tag="wide"/>
                    <ComboBoxItem Content="Delgado (brazos slim)" Tag="slim"/>
                  </ComboBox>
                  <TextBlock Text="Skin PNG del perfil local" FontWeight="SemiBold"/>
                  <TextBlock x:Name="OfflineSkinPathLabel" Text="Se usará la skin guardada actualmente." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <Button Content="Elegir skin…" Click="BrowseOfflineSkin_Click" Padding="12,7" Margin="0,0,8,8"/>
                    <Button Content="Quitar skin personalizada" Click="RemoveOfflineSkin_Click" Padding="12,7" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <Button Content="Guardar perfil sin conexión" Click="SaveOfflineProfile_Click" HorizontalAlignment="Left" Padding="12,7"/>
                  <TextBlock Text="Este perfil permite probar el juego sin iniciar sesión en Microsoft. No sirve para entrar a servidores que exijan una cuenta premium." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <TextBlock x:Name="OfflineProfileStatus" IsVisible="False" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="NormalSettingsPanel" IsVisible="True" Spacing="18">
                
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Memoria RAM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RamValueText" Grid.Column="1" Text="4096 MB" Foreground="#6AD8E8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Grid>
                  <Slider x:Name="RamSlider" Minimum="1024" Maximum="32768" Value="4096" TickFrequency="512" IsSnapToTickEnabled="False" ValueChanged="RamSlider_ValueChanged"/>
                  <TextBlock Text="Memoria máxima que Minecraft puede usar." FontSize="11" Foreground="#8D99A5"/>
                </StackPanel>
                <CheckBox x:Name="AutomaticJavaInput" Content="Usar Java detectado automáticamente" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <CheckBox x:Name="EnableCustomJavaArgumentsInput" Content="Activar argumentos de Java personalizados" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Argumentos de Java personalizados" FontWeight="SemiBold"/>
                  <TextBox x:Name="CustomJavaArgumentsInput" Watermark="-XX:+UseG1GC ..." AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" TextChanged="SettingsAutoSave_Changed"/>
                  <TextBlock Text="Se aplican junto con los argumentos que genera el launcher." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Ruta de Java personalizada" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="JavaPathInput" Watermark="Ruta al ejecutable de Java" TextChanged="SettingsAutoSave_Changed"/>
                    <Button Grid.Column="1" Content="Examinar…" Click="BrowseJava_Click" Padding="12,7"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Comprobar Java" Click="CheckJava_Click" Padding="12,7"/>
                    <TextBlock x:Name="JavaStatus" Text="Sin comprobar" VerticalAlignment="Center" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                
                <CheckBox x:Name="CloseLauncherInput" Content="Cerrar el launcher al iniciar el juego" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <CheckBox x:Name="ShowConsoleInput" Content="Mostrar la consola del juego" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <CheckBox x:Name="HolidayThemesInput" Content="Permitir temas especiales de temporada" IsCheckedChanged="SettingsAutoSave_Changed"/>
                <CheckBox x:Name="DeveloperModeInput" Content="Activar modo desarrollador (Minecraft Vanilla)" IsCheckedChanged="DeveloperModeInput_Changed"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="ID del catálogo de modpacks (Google Drive)" FontWeight="SemiBold"/>
                  <TextBox x:Name="CatalogFileIdInput" Watermark="ID del archivo JSON del catálogo" TextChanged="SettingsAutoSave_Changed"/>
                  <TextBlock Text="Se guarda localmente. El archivo debe ser accesible sin iniciar sesión en Google." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="Carpeta de datos e instalaciones" FontWeight="SemiBold"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="StoragePathInput" Watermark="Ruta de almacenamiento"/>
                    <Button Grid.Column="1" Content="Examinar…" Click="BrowseStorage_Click" Padding="12,7"/>
                  </Grid>
                  <TextBlock Text="Al cambiarla, el launcher intentará mover las instancias y los archivos compartidos. Usa una carpeta vacía o una ubicación existente compatible." FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Guardar ajustes" Click="SaveSettings_Click" Background="#58D0E3" Foreground="#0A0D11" Padding="16,10"/>
                  <Button Content="Restablecer formulario" Click="ReloadSettings_Click" Padding="16,10"/>
                </StackPanel>
                <StackPanel Spacing="8">
                  <TextBlock Text="Uso de almacenamiento" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StorageUsageLabel" Text="Calculando…" FontSize="11" Foreground="#8D99A5" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Actualizar uso" Click="RefreshStorageUsage_Click" Padding="12,7"/>
                    <Button Content="Limpiar caché de paquetes" Click="ClearPackageCache_Click" Padding="12,7"/>
                    <Button Content="Limpiar temporales" Click="ClearTemporaryFiles_Click" Padding="12,7"/>
                    <Button x:Name="CleanupUnusedFilesButton" Content="Limpiar archivos no utilizados" Click="CleanupUnusedFiles_Click" Padding="12,7"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CleanupUnusedFilesStatus" IsVisible="False" TextWrapping="Wrap" Foreground="#F0C674"/>
                <TextBlock x:Name="SettingsMessage" IsVisible="False" TextWrapping="Wrap" Foreground="#A6E3B1"/>
              </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="DeveloperPage" IsVisible="False" Spacing="18" Margin="28">
            <StackPanel Spacing="6">
              <TextBlock Text="MINECRAFT VANILLA" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="Modo desarrollador" FontSize="14" Foreground="#8D99A5"/>
            </StackPanel>
            <Border Background="#111820" BorderBrush="#27323D" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel Spacing="16">
                <TextBlock Text="VERSIÓN DE MINECRAFT" Foreground="#6AD8E8" FontSize="11" FontWeight="Bold"/>
                <ComboBox x:Name="DeveloperVersionComboBox" PlaceholderText="Selecciona una versión" MinHeight="40" SelectionChanged="DeveloperVersionComboBox_SelectionChanged"/>
                <StackPanel Spacing="10">
                  <CheckBox x:Name="DeveloperShowSnapshotsCheckBox" Content="Mostrar snapshots" IsChecked="False" IsCheckedChanged="DeveloperVersionFilter_Changed"/>
                  <CheckBox x:Name="DeveloperShowBetasCheckBox" Content="Mostrar versiones beta y alpha antiguas" IsChecked="False" IsCheckedChanged="DeveloperVersionFilter_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="DeveloperReloadVersionsButton" Content="ACTUALIZAR VERSIONES" Click="DeveloperReloadVersions_Click" Padding="14,10"/>
                  <Button x:Name="DeveloperPlayButton" Content="JUGAR" Click="DeveloperVanillaPlay_Click" IsEnabled="False" Background="#38899A" Foreground="White" Padding="28,12" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <ProgressBar x:Name="DeveloperProgress" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="8"/>
                <Button x:Name="CancelDeveloperPreparationButton" Content="Cancelar preparación" Click="CancelDeveloperPreparation_Click" IsVisible="False" HorizontalAlignment="Left" Padding="12,7" Background="#3A2025" Foreground="#FFC4C4"/>
                <TextBlock x:Name="DeveloperStatus" Text="Carga las versiones oficiales de Minecraft." Foreground="#B8BEC6" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="GlobalCountdownHost" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="18,18,0,0" MaxWidth="1040" IsVisible="False" IsHitTestVisible="False"/>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
  <Grid x:Name="LoginGate" Grid.RowSpan="2" Panel.ZIndex="100" IsVisible="False" Background="#090B0E" ColumnDefinitions="1.12*,0.88*">
    <Grid Grid.Column="0" ClipToBounds="True">
      <Image x:Name="LoginBackgroundImage" Stretch="UniformToFill" Opacity="0.78"/>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#16090B0E" Offset="0"/>
            <GradientStop Color="#50090B0E" Offset="0.72"/>
            <GradientStop Color="#E6090B0E" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <StackPanel VerticalAlignment="Bottom" Margin="42,40,34,48" Spacing="8">
        <Image x:Name="LoginBrandLogo" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <TextBlock Text="NEGATIVE CLIENT" Foreground="White" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Forjamos mundos, creamos experiencias." Foreground="#B9C6D0" FontSize="15" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Background="#11151A" RowDefinitions="48,*,42">
      <Grid Grid.Row="0" Background="#292B2E" PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="NEGATIVE CLIENT" Foreground="#D8E0E6" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
            <Button Classes="window-control" Click="MinimizeWindow_Click" ToolTip.Tip="Minimizar">
              <Border Classes="window-control-circle" Width="18" Height="18" CornerRadius="9" Background="#35373A">
                <TextBlock Text="—" Foreground="#D6D9DB" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Button>
            <Button Classes="window-control" Click="CloseWindow_Click" ToolTip.Tip="Cerrar">
              <Border Classes="window-control-circle" Width="18" Height="18" CornerRadius="9" Background="#35373A">
                <TextBlock Text="×" Foreground="#D6D9DB" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,22" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="Bienvenido" Foreground="White" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="Inicia sesión para entrar al launcher." Foreground="#AEB9C2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Border Background="#1A2027" BorderBrush="#343D46" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="Cuenta Microsoft" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Para Minecraft: Java Edition con una cuenta oficial." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap"/>
              <Button x:Name="LoginMicrosoftButton" Content="Iniciar sesión con Microsoft" Click="LoginMicrosoftButton_Click" Height="44" Background="#29333E" Foreground="White" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <Border Background="#171D23" BorderBrush="#343D46" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
              <StackPanel x:Name="LoginOptionsPanel" Spacing="10">
                <TextBlock Text="Modo no premium" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Entra con un nombre de usuario, sin autenticar una cuenta Microsoft." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap"/>
                <Button x:Name="ChooseOfflineLoginButton" Content="Entrar como no premium" Click="ChooseOfflineLoginButton_Click" Height="42" Background="#202A33" Foreground="White"/>
              </StackPanel>
              <StackPanel x:Name="OfflineLoginPanel" IsVisible="False" Spacing="9">
                <TextBlock Text="Entrar como no premium" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Elige el nombre que aparecerá en el juego." Foreground="#AEB9C2" FontSize="11" TextWrapping="Wrap"/>
                <TextBox x:Name="OfflineUsernameBox" Watermark="Nombre (3–16 caracteres)" MaxLength="16" Height="40"/>
                <Button x:Name="LoginOfflineButton" Content="Entrar" Click="LoginOfflineButton_Click" Height="42" Background="#202A33" Foreground="White"/>
                <Button x:Name="BackToLoginOptionsButton" Content="Volver a las opciones de cuenta" Click="BackToLoginOptionsButton_Click" Height="36"/>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock x:Name="LoginStatusText" Foreground="#6AD8E8" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="NegativeStudios" Foreground="#65717B" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
  </Grid>
</Window>
